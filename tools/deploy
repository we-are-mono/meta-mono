#!/usr/bin/env python3
"""
Automated build and deployment tool for Gateway DK (LS1046A).

Builds Yocto images and flashes them to the target via network,
using UART for device control.

Note: HTTP server runs on private network between host and target.
TLS is unnecessary for this use case (local dev network, no internet exposure).
"""

import argparse
import hashlib
import ipaddress
import json
import logging
import re
import signal
import subprocess
import sys
import threading
import time
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path
from typing import Optional

import serial
import yaml
from rich.console import Console
from rich.logging import RichHandler
from rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn, TaskProgressColumn, TaskID
from rich.rule import Rule

# Constants
IP_SCAN_RANGE = (200, 251)
SERIAL_POLL_INTERVAL = 0.1
CHUNK_SIZE = 8192
NETWORK_RETRIES = 3
RETRY_DELAY = 2
TIMEOUTS = {
    "uboot_interrupt": 30,
    "recovery_boot": 30,
    "command_default": 300,
    "download": 600,
    "flash": 300,  # eMMC flash timeout
    "flash_qspi": 600,  # QSPI flash can take ~4min
}

# Serial prompt patterns
PROMPT_UBOOT = "=>"
PROMPT_SHELL = "# "
PROMPT_RECOVERY = "@recovery"  # Matches "root@recovery:~# "
PROMPT_LOGIN = "login:"

# Required config keys for validation
REQUIRED_CONFIG = {
    "network": ["host_interface", "target_interface", "http_port"],
    "serial": ["device", "baudrate"],
    "build": ["deploy_dir"],
    "artifacts": ["firmware_qspi", "firmware_emmc", "rootfs"],
}

# Pattern to match progress output like "Erasing blocks: 5138/8192" or "Writing data: 100k/32768k"
PROGRESS_PATTERN = re.compile(r'(\d+)k?/(\d+)k?')
# Pattern to extract the phase (Erasing, Writing, Verifying) from flashcp output
PHASE_PATTERN = re.compile(r'(Erasing|Writing|Verifying)')

# Rich console for formatted output
console = Console()

# Configure logging with rich handler
logging.basicConfig(
    level=logging.INFO,
    format="%(message)s",
    datefmt="[%H:%M:%S]",
    handlers=[RichHandler(console=console, rich_tracebacks=True, show_path=False)],
)
log = logging.getLogger(__name__)


class FlashError(Exception):
    """Raised when a flash operation fails."""


class InterruptedError(Exception):
    """Raised when operation is interrupted by user."""


# Global flag for interrupt handling
_interrupted = False


def _signal_handler(_signum: int, _frame) -> None:
    """Handle SIGINT for graceful shutdown."""
    global _interrupted
    _interrupted = True
    log.warning("\nInterrupt received, cleaning up... (press Ctrl+C again to force quit)")
    # Restore default handler for immediate exit on second Ctrl+C
    signal.signal(signal.SIGINT, signal.SIG_DFL)


class SerialConsole:
    """Manages UART connection to target device."""

    def __init__(self, port: str, baudrate: int = 115200, timeout: float = 1.0):
        self.port = port
        self.baudrate = baudrate
        self.timeout = timeout
        self.ser: Optional[serial.Serial] = None

    def __enter__(self) -> "SerialConsole":
        if not self.connect():
            raise RuntimeError(f"Failed to connect to {self.port}")
        return self

    def __exit__(self, *args) -> None:
        self.close()

    def connect(self) -> bool:
        """Establish serial connection."""
        try:
            self.ser = serial.Serial(
                port=self.port,
                baudrate=self.baudrate,
                timeout=self.timeout,
                write_timeout=self.timeout,
            )
            self.ser.reset_input_buffer()
            return True
        except serial.SerialException as e:
            log.error(f"Failed to open {self.port}: {e}")
            return False

    def close(self) -> None:
        """Close serial connection."""
        if self.ser and self.ser.is_open:
            self.ser.close()

    def send(self, data: str) -> None:
        """Send data without waiting for response."""
        if self.ser:
            self.ser.write(data.encode())
            self.ser.flush()

    def send_command(
        self,
        cmd: str,
        wait_for: Optional[str] = None,
        timeout: float = 30,
        progress: Optional[Progress] = None,
        task_id: Optional[TaskID] = None,
    ) -> Optional[str]:
        """Send command and optionally wait for a pattern.

        Returns output if wait_for pattern found, empty string if no wait_for specified,
        or None on timeout/error.
        """
        if not self.ser:
            return None

        self.ser.reset_input_buffer()
        self.ser.write(f"{cmd}\n".encode())
        self.ser.flush()

        if wait_for:
            return self.wait_for_pattern(wait_for, timeout, progress, task_id)
        return ""

    def wait_for_pattern(
        self,
        pattern: str,
        timeout: float = 60,
        progress: Optional[Progress] = None,
        task_id: Optional[TaskID] = None,
    ) -> Optional[str]:
        """Wait for a pattern in serial output.

        Returns accumulated output if pattern found, None on timeout.
        """
        return self.wait_for_patterns([pattern], timeout, progress, task_id)

    def wait_for_patterns(
        self,
        patterns: list[str],
        timeout: float = 60,
        progress: Optional[Progress] = None,
        task_id: Optional[TaskID] = None,
    ) -> Optional[str]:
        """Wait for any of the given patterns in serial output.

        Returns accumulated output if any pattern found, None on timeout.
        Optionally updates a rich Progress bar if progress/task_id provided.
        """
        if not self.ser:
            return None

        output = ""
        start = time.time()
        while time.time() - start < timeout:
            if self.ser.in_waiting:
                try:
                    chunk = self.ser.read(self.ser.in_waiting).decode(errors="replace")
                    output += chunk

                    # Update progress bar if tracking
                    if progress is not None and task_id is not None:
                        # Check for phase change (Erasing/Writing/Verifying)
                        phase_match = PHASE_PATTERN.search(chunk)
                        if phase_match:
                            phase = phase_match.group(1)
                            # Only update description if phase changed (don't reset progress)
                            task = progress.tasks[task_id]
                            if task.description != f"{phase}...":
                                progress.update(task_id, description=f"{phase}...")
                        # Update progress numbers
                        prog_match = PROGRESS_PATTERN.search(chunk)
                        if prog_match:
                            current, total = int(prog_match.group(1)), int(prog_match.group(2))
                            progress.update(task_id, completed=current, total=total)
                        # Skip debug logging for progress output - it's redundant with the bar
                    else:
                        # Log each line separately for readable output
                        for line in chunk.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
                            if line.strip():
                                log.debug(f"Serial: {line}")

                    for pattern in patterns:
                        if pattern in output:
                            return output
                except serial.SerialException as e:
                    log.warning(f"Serial read error: {e}")
                except UnicodeDecodeError as e:
                    log.debug(f"Decode error (ignored): {e}")
            time.sleep(SERIAL_POLL_INTERVAL)
        log.debug(f"Timeout waiting for {patterns!r}, got: {output[-200:]!r}")
        return None  # Timeout

    def probe_state(self) -> str:
        """Probe device state by sending commands. Returns 'uboot', 'recovery', 'sdk', 'login', or 'unknown'.

        Note: This method has side effects - it sends data to the device.
        """
        if not self.ser:
            return "unknown"

        # Send newline and see what comes back
        self.ser.reset_input_buffer()
        self.ser.write(b"\n")
        self.ser.flush()
        time.sleep(0.5)

        output = ""
        while self.ser.in_waiting:
            output += self.ser.read(self.ser.in_waiting).decode(errors="replace")

        # Check for known prompts
        if PROMPT_UBOOT in output:
            return "uboot"
        if PROMPT_RECOVERY in output:
            # Prompt contains "@recovery" - definitely recovery mode
            return "recovery"
        if PROMPT_SHELL in output:
            # Generic shell prompt without @recovery - assume SDK
            return "sdk"
        if PROMPT_LOGIN in output:
            return "login"

        return "unknown"

    def interrupt_uboot(self, timeout: float = TIMEOUTS["uboot_interrupt"]) -> bool:
        """Wait for U-Boot and interrupt autoboot."""
        if not self.ser:
            return False

        log.info("Waiting for U-Boot prompt...")
        start = time.time()
        output = ""
        interrupt_sent = False

        while time.time() - start < timeout:
            if self.ser.in_waiting:
                chunk = self.ser.read(self.ser.in_waiting).decode(errors="replace")
                output += chunk
                # Send space to interrupt when we see the autoboot message
                # Check accumulated output to handle pattern spanning chunks
                if not interrupt_sent and ("Hit any key" in output or "autoboot" in output.lower()):
                    self.ser.write(b" ")
                    self.ser.flush()
                    interrupt_sent = True
                    log.debug("Sent interrupt key")
                if PROMPT_UBOOT in output:
                    log.info("U-Boot prompt reached")
                    return True
            time.sleep(0.05)

        log.warning(f"U-Boot interrupt timeout after {timeout}s")
        return False

    def boot_to_recovery(self, max_attempts: int = 3) -> bool:
        """Boot target into recovery mode."""
        for attempt in range(max_attempts):
            state = self.probe_state()
            log.info(f"Current state: {state} (attempt {attempt + 1}/{max_attempts})")

            if state == "recovery":
                log.info("Already in recovery mode")
                return True

            if state == "login":
                log.info("Logging in...")
                self.send_command("root", wait_for=PROMPT_SHELL, timeout=10)
                state = "sdk"  # Now we're logged in

            if state == "sdk":
                log.info("Rebooting from Linux...")
                self.send_command("reboot")
                time.sleep(2)
                if not self.interrupt_uboot(timeout=TIMEOUTS["recovery_boot"]):
                    log.error("Failed to interrupt U-Boot")
                    continue
                state = "uboot"

            if state == "uboot":
                log.info("Booting recovery image...")
                self.send("run recovery\n")
                # Wait for either login prompt (success) or U-Boot prompt (boot failure)
                output = self.wait_for_patterns(
                    [PROMPT_LOGIN, PROMPT_UBOOT], timeout=TIMEOUTS["recovery_boot"]
                )
                if output and PROMPT_UBOOT in output:
                    log.error("Recovery boot failed (returned to U-Boot) - recovery image may be corrupted")
                    return False
                if output and PROMPT_LOGIN in output:
                    log.info("Recovery login prompt detected, logging in...")
                    self.send_command("root", wait_for=PROMPT_SHELL, timeout=10)
                    time.sleep(0.5)
                    if self.probe_state() == "recovery":
                        log.info("Recovery mode active")
                        return True

            if state == "unknown":
                log.info("Unknown state, attempting to get prompt...")
                self.send("\n")
                time.sleep(1)
                # Loop will retry with fresh state detection

        log.error("Could not reach recovery mode")
        return False


class ArtifactHandler(SimpleHTTPRequestHandler):
    """HTTP handler that only serves explicitly allowed files."""

    allowed_files: set[str] = set()
    serve_directory: str = "."

    def __init__(self, *args, **kwargs):
        # Pass directory to parent - use class attribute as default
        super().__init__(*args, directory=self.serve_directory, **kwargs)

    def do_GET(self) -> None:
        """Serve file only if it's in the allowed list."""
        # Strip leading slash and query string
        filename = self.path.lstrip("/").split("?")[0]

        if filename not in self.allowed_files:
            self.send_error(403, "Forbidden")
            return

        super().do_GET()

    def log_message(self, _format: str, *args) -> None:
        """Log HTTP requests via our logger."""
        log.debug(f"HTTP: {args[0]}")


class DeployServer:
    """HTTP server for serving build artifacts.

    Note: Binds to specific host IP, not 0.0.0.0, to limit exposure.
    Only serves explicitly allowed files (no directory listing).
    """

    def __init__(self, directory: str, allowed_files: set[str], host: str = "127.0.0.1", port: int = 8000):
        self.directory = directory
        self.allowed_files = allowed_files
        self.host = host
        self.port = port
        self._server: Optional[HTTPServer] = None
        self._thread: Optional[threading.Thread] = None

    def start(self) -> None:
        """Start server in background thread."""
        # Create handler class with allowed files and directory
        handler = type(
            "BoundArtifactHandler",
            (ArtifactHandler,),
            {"allowed_files": self.allowed_files, "serve_directory": self.directory},
        )
        self._server = HTTPServer((self.host, self.port), handler)
        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()
        log.info(f"HTTP server started on {self.host}:{self.port} (serving {len(self.allowed_files)} files)")

    def stop(self) -> None:
        """Stop the server."""
        if self._server:
            self._server.shutdown()
            log.info("HTTP server stopped")


def validate_config(config: dict) -> None:
    """Validate config has all required keys."""
    for section, keys in REQUIRED_CONFIG.items():
        if section not in config:
            raise ValueError(f"Missing config section: {section}")
        for key in keys:
            if key not in config[section]:
                raise ValueError(f"Missing config key: {section}.{key}")


def get_host_network(interface: str) -> dict[str, Optional[str | int]]:
    """Get network info (ip, prefix, gateway) for an interface."""
    result: dict[str, Optional[str | int]] = {"ip": None, "prefix": None, "gateway": None}

    # Get IP address
    try:
        output = subprocess.check_output(
            ["ip", "-j", "addr", "show", interface], text=True
        )
        data = json.loads(output)
        for iface in data:
            for addr_info in iface.get("addr_info", []):
                if addr_info.get("family") == "inet":
                    result["ip"] = addr_info["local"]
                    result["prefix"] = addr_info["prefixlen"]
                    break
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as e:
        log.error(f"Error getting IP for {interface}: {e}")
        return result

    # Get gateway from routing table
    try:
        output = subprocess.check_output(["ip", "-j", "route"], text=True)
        routes = json.loads(output)
        for route in routes:
            if route.get("dst") == "default" and route.get("dev") == interface:
                result["gateway"] = route.get("gateway")
                break
        # If no default route found, check for any route via this interface
        if not result["gateway"]:
            for route in routes:
                if route.get("dev") == interface and route.get("gateway"):
                    result["gateway"] = route.get("gateway")
                    break
        if not result["gateway"]:
            log.warning(f"No gateway found for {interface} - target may need manual gateway config")
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        log.warning(f"Error getting gateway: {e}")

    return result


def find_unused_ip(host_ip: str, prefix: int) -> str:
    """Find an unused IP address on the network."""
    network = ipaddress.IPv4Network(f"{host_ip}/{prefix}", strict=False)
    host = ipaddress.IPv4Address(host_ip)

    start, end = IP_SCAN_RANGE
    for i in range(start, end):
        candidate = network.network_address + i
        if candidate == host or candidate == network.broadcast_address:
            continue
        if candidate not in network:
            continue

        # Check if IP is in use via arping (fast ARP check)
        try:
            result = subprocess.run(
                ["arping", "-c", "1", "-w", "1", str(candidate)],
                capture_output=True,
                timeout=3,
            )
            if result.returncode != 0:  # No response = IP is free
                return str(candidate)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            # If arping not available or times out, try ping
            try:
                result = subprocess.run(
                    ["ping", "-c", "1", "-W", "1", str(candidate)],
                    capture_output=True,
                    timeout=3,
                )
                if result.returncode != 0:
                    return str(candidate)
            except subprocess.TimeoutExpired:
                return str(candidate)

    raise RuntimeError(f"Could not find unused IP in .{start}-.{end} range")


def run_build(project_root: Path, target: str = "all") -> None:
    """Run kas/bitbake build."""
    if target in ("all", "firmware"):
        log.info("Building firmware image...")
        result = subprocess.run(
            ["kas", "shell", "kas/recovery.yaml", "-c", "bitbake firmware-image"],
            cwd=project_root,
        )
        if result.returncode != 0:
            raise RuntimeError("Firmware build failed")

    if target in ("all", "sdk"):
        log.info("Building SDK image...")
        result = subprocess.run(
            ["kas", "shell", "kas/mono-sdk.yaml", "-c", "bitbake mono-sdk-image"],
            cwd=project_root,
        )
        if result.returncode != 0:
            raise RuntimeError("SDK build failed")


def compute_sha256(filepath: Path) -> str:
    """Compute SHA256 checksum of a file."""
    sha256 = hashlib.sha256()
    with open(filepath, "rb") as f:
        for chunk in iter(lambda: f.read(CHUNK_SIZE), b""):
            sha256.update(chunk)
    return sha256.hexdigest()


def run_target_cmd(
    serial_console: SerialConsole,
    cmd: str,
    timeout: float = TIMEOUTS["command_default"],
    check: bool = True,
    progress: Optional[Progress] = None,
    task_id: Optional[TaskID] = None,
) -> tuple[bool, str]:
    """Run command on target and check success.

    Returns (success, output) tuple. Raises FlashError if check=True and command fails.
    """
    log.debug(f"Running: {cmd}")
    output = serial_console.send_command(
        cmd, wait_for=PROMPT_SHELL, timeout=timeout, progress=progress, task_id=task_id
    ) or ""

    # Get exit status
    time.sleep(0.1)
    exit_output = serial_console.send_command("echo EXIT:$?", wait_for=PROMPT_SHELL, timeout=5) or ""

    # Parse exit code from output (look for EXIT: marker)
    exit_code = None
    for line in exit_output.split("\n"):
        line = line.strip()
        if line.startswith("EXIT:"):
            try:
                exit_code = int(line[5:])
                break
            except ValueError:
                pass

    success = exit_code == 0
    if not success and check:
        log.error(f"Command failed (exit {exit_code}): {cmd}")
        raise FlashError(f"Command failed: {cmd}")

    return success, output


def check_interrupted() -> None:
    """Raise InterruptedError if user requested abort."""
    if _interrupted:
        raise InterruptedError("Operation interrupted by user")


def flash_target(
    serial_console: SerialConsole,
    host_ip: str,
    target_ip: str,
    gateway: Optional[str],
    prefix: int,
    target_iface: str,
    http_port: int,
    artifacts: dict[str, str],
    deploy_dir: Path,
    firmware_only: bool = False,
    rootfs_only: bool = False,
    qspi_only: bool = False,
    emmc_only: bool = False,
) -> None:
    """Flash firmware and rootfs to target."""
    check_interrupted()

    log.info("Configuring target network...")
    run_target_cmd(serial_console, f"ip link set {target_iface} up")

    # IP addr add fails if already assigned - that's acceptable
    success, output = run_target_cmd(serial_console, f"ip addr add {target_ip}/{prefix} dev {target_iface}", check=False)
    if not success and "File exists" not in output:
        raise FlashError(f"Failed to configure IP: {output}")

    # Route add fails if already exists - that's acceptable
    if gateway:
        success, output = run_target_cmd(serial_console, f"ip route add default via {gateway} dev {target_iface}", check=False)
        if not success and "File exists" not in output:
            log.warning(f"Could not add default route: {output}")

    # Verify connectivity using ping return code
    log.info(f"Verifying network connectivity to {host_ip}...")
    success, _ = run_target_cmd(serial_console, f"ping -c 1 -W 3 {host_ip}", check=False)
    if not success:
        raise FlashError(f"Cannot reach host {host_ip} from target")
    log.info("Network connectivity OK")

    base_url = f"http://{host_ip}:{http_port}"

    def download_and_verify(artifact_key: str) -> None:
        """Download artifact and verify SHA256 checksum with retry logic."""
        filename = artifacts[artifact_key]
        local_path = deploy_dir / filename
        expected_hash = compute_sha256(local_path)

        # Download with retries
        last_error = None
        for attempt in range(1, NETWORK_RETRIES + 1):
            log.info(f"Downloading {filename}... (attempt {attempt}/{NETWORK_RETRIES})")
            success, output = run_target_cmd(
                serial_console, f"curl -f -O {base_url}/{filename}", timeout=TIMEOUTS["download"], check=False
            )
            if success:
                break
            last_error = output
            if attempt < NETWORK_RETRIES:
                log.warning(f"Download failed, retrying in {RETRY_DELAY}s...")
                time.sleep(RETRY_DELAY)
        else:
            raise FlashError(f"Failed to download {filename} after {NETWORK_RETRIES} attempts: {last_error}")

        # Verify checksum on target
        log.info(f"Verifying {filename} checksum...")
        success, output = run_target_cmd(serial_console, f"sha256sum {filename}", timeout=60)

        # Parse sha256sum output - find 64-char hex hash in output
        match = re.search(r'([a-f0-9]{64})', output.lower())
        actual_hash = match.group(1) if match else ""

        if actual_hash != expected_hash:
            raise FlashError(f"Checksum mismatch for {filename}: expected {expected_hash[:16]}..., got {actual_hash[:16]}...")
        log.info(f"Checksum OK: {expected_hash[:16]}...")

    # QSPI: skip if rootfs_only or emmc_only
    if not rootfs_only and not emmc_only:
        check_interrupted()
        console.print()
        console.print(Rule("Flashing QSPI firmware", style="bold blue"))
        console.print()
        download_and_verify("firmware_qspi")

        # flashcp outputs progress like "Erasing blocks: X/Y" and "Writing data: X/Y"
        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            TaskProgressColumn(),
            console=console,
            transient=True,
        ) as progress:
            task = progress.add_task("Flashing QSPI NOR...", total=None)
            run_target_cmd(
                serial_console,
                f"flashcp -v {artifacts['firmware_qspi']} /dev/mtd0",
                timeout=TIMEOUTS["flash_qspi"],
                progress=progress,
                task_id=task,
            )
        console.print()
        console.print(Rule("QSPI flash complete", style="green"))
        console.print()

    # eMMC boot area: skip if rootfs_only or qspi_only
    if not rootfs_only and not qspi_only:
        check_interrupted()
        console.print()
        console.print(Rule("Flashing eMMC boot area", style="bold blue"))
        console.print()
        download_and_verify("firmware_emmc")

        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            console=console,
            transient=True,
        ) as progress:
            task = progress.add_task("Writing eMMC boot area...", total=None)
            run_target_cmd(
                serial_console,
                f"dd if={artifacts['firmware_emmc']} of=/dev/mmcblk0 bs=1M",
                timeout=TIMEOUTS["flash"],
                progress=progress,
                task_id=task,
            )
        console.print()
        console.print(Rule("eMMC boot area flash complete", style="green"))
        console.print()

    # rootfs: skip if firmware_only, qspi_only, or emmc_only
    if not firmware_only and not qspi_only and not emmc_only:
        check_interrupted()
        console.print()
        console.print(Rule("Flashing rootfs", style="bold blue"))
        console.print()
        download_and_verify("rootfs")

        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            console=console,
            transient=True,
        ) as progress:
            task = progress.add_task("Writing rootfs to eMMC...", total=None)
            run_target_cmd(
                serial_console,
                f"dd if={artifacts['rootfs']} of=/dev/mmcblk0p1 bs=1M",
                timeout=TIMEOUTS["command_default"],
                progress=progress,
                task_id=task,
            )
        console.print()
        console.print(Rule("Rootfs flash complete", style="green"))
        console.print()

    log.info("Syncing...")
    run_target_cmd(serial_console, "sync")

    # Clean up downloaded files from target
    log.info("Cleaning up downloaded files...")
    for filename in artifacts.values():
        run_target_cmd(serial_console, f"rm -f {filename}", check=False)

    console.print()
    console.print(Rule("Flash complete!", style="bold green"))
    console.print()


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Build and deploy Gateway DK firmware",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s                  Full build and flash
  %(prog)s build            Build all images
  %(prog)s build --firmware-only   Build firmware only
  %(prog)s build --rootfs-only     Build rootfs only
  %(prog)s flash            Flash all (use existing artifacts)
  %(prog)s flash --firmware-only   Flash firmware only (QSPI + eMMC boot)
  %(prog)s flash --qspi-only       Flash QSPI NOR only
  %(prog)s flash --emmc-only       Flash eMMC boot area only
  %(prog)s status           Show target device status
  %(prog)s recovery         Reboot into recovery mode
""",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="deploy",
        choices=["deploy", "build", "flash", "status", "recovery"],
        help="Command to run (default: deploy)",
    )
    flash_scope = parser.add_mutually_exclusive_group()
    flash_scope.add_argument(
        "--firmware-only", action="store_true", help="Only flash firmware (skip rootfs)"
    )
    flash_scope.add_argument(
        "--rootfs-only", action="store_true", help="Only flash rootfs (skip firmware)"
    )
    flash_scope.add_argument(
        "--qspi-only", action="store_true", help="Only flash QSPI NOR (skip eMMC)"
    )
    flash_scope.add_argument(
        "--emmc-only", action="store_true", help="Only flash eMMC (boot area + rootfs, skip QSPI)"
    )
    parser.add_argument(
        "--no-build", action="store_true", help="Skip build step"
    )
    parser.add_argument(
        "--no-reboot", action="store_true", help="Don't reboot after flashing"
    )
    parser.add_argument(
        "--config", type=Path, default=Path(__file__).parent / "config.yaml",
        help="Config file path",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="Verbose output")
    args = parser.parse_args()

    # Set log level based on verbose flag
    if args.verbose:
        logging.getLogger().setLevel(logging.DEBUG)

    # Install signal handler for graceful interrupt
    signal.signal(signal.SIGINT, _signal_handler)

    # Load config
    if not args.config.exists():
        log.error(f"Config file not found: {args.config}")
        sys.exit(1)

    try:
        with open(args.config) as f:
            config = yaml.safe_load(f)
        validate_config(config)
    except (yaml.YAMLError, ValueError) as e:
        log.error(f"Config error: {e}")
        sys.exit(1)

    # Determine project root
    project_root = Path(__file__).parent.parent.resolve()
    deploy_dir = project_root / config["build"]["deploy_dir"]

    # Determine build target based on flags
    if args.firmware_only or args.qspi_only or args.emmc_only:
        build_target = "firmware"
    elif args.rootfs_only:
        build_target = "sdk"
    else:
        build_target = "all"

    # Handle commands
    if args.command == "build":
        run_build(project_root, build_target)
        return

    # Commands that need serial
    try:
        with SerialConsole(config["serial"]["device"], config["serial"]["baudrate"]) as serial:
            if args.command == "status":
                state = serial.probe_state()
                log.info(f"Target state: {state}")
                return

            if args.command == "recovery":
                console.print()
                console.print(Rule("Booting to recovery", style="bold blue"))
                console.print()
                if serial.boot_to_recovery():
                    console.print()
                    console.print(Rule("Recovery mode active", style="green"))
                    console.print()
                else:
                    sys.exit(1)
                return

            # deploy or flash command
            if args.command == "deploy" and not args.no_build:
                run_build(project_root, build_target)

            # Determine which artifacts are needed based on flags
            artifacts = config["artifacts"]
            needed_artifacts = {}
            if not args.rootfs_only and not args.emmc_only:
                needed_artifacts["firmware_qspi"] = artifacts["firmware_qspi"]
            if not args.rootfs_only and not args.qspi_only:
                needed_artifacts["firmware_emmc"] = artifacts["firmware_emmc"]
            if not args.firmware_only and not args.qspi_only and not args.emmc_only:
                needed_artifacts["rootfs"] = artifacts["rootfs"]

            # Verify needed artifacts exist
            for name, filename in needed_artifacts.items():
                path = deploy_dir / filename
                if not path.exists():
                    log.error(f"Artifact not found: {path}")
                    sys.exit(1)
                log.info(f"Found: {filename} ({path.stat().st_size / 1024 / 1024:.1f} MB)")

            # Get network info
            log.info(f"Detecting network on {config['network']['host_interface']}...")
            net = get_host_network(config["network"]["host_interface"])
            if not net["ip"]:
                log.error(f"Could not get IP for {config['network']['host_interface']}")
                sys.exit(1)

            log.info(f"Host IP: {net['ip']}/{net['prefix']}")
            log.info(f"Gateway: {net['gateway']}")

            # Find unused IP for target
            log.info("Finding unused IP for target...")
            target_ip = find_unused_ip(str(net["ip"]), int(net["prefix"]))
            log.info(f"Target IP: {target_ip}")

            # Start HTTP server bound to host IP only, serving only the needed artifact files
            allowed_files = set(needed_artifacts.values())
            server = DeployServer(str(deploy_dir), allowed_files, host=str(net["ip"]), port=config["network"]["http_port"])
            server.start()

            try:
                # Boot to recovery
                console.print()
                console.print(Rule("Booting to recovery", style="bold blue"))
                console.print()
                if not serial.boot_to_recovery():
                    log.error("Could not boot to recovery mode")
                    sys.exit(1)
                console.print()
                console.print(Rule("Recovery mode active", style="green"))
                console.print()

                # Flash
                try:
                    flash_target(
                        serial_console=serial,
                        host_ip=str(net["ip"]),
                        target_ip=target_ip,
                        gateway=str(net["gateway"]) if net["gateway"] else None,
                        prefix=int(net["prefix"]),
                        target_iface=config["network"]["target_interface"],
                        http_port=config["network"]["http_port"],
                        artifacts=needed_artifacts,
                        deploy_dir=deploy_dir,
                        firmware_only=args.firmware_only,
                        rootfs_only=args.rootfs_only,
                        qspi_only=args.qspi_only,
                        emmc_only=args.emmc_only,
                    )
                except FlashError as e:
                    log.error(str(e))
                    sys.exit(1)
                except InterruptedError:
                    log.error("Flash aborted by user - target may be in inconsistent state!")
                    sys.exit(130)  # Standard exit code for SIGINT

                if not args.no_reboot:
                    log.info("Rebooting target...")
                    serial.send_command("reboot")
                    log.info("Target is rebooting")

            finally:
                server.stop()

    except RuntimeError as e:
        log.error(str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
