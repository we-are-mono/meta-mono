network:
  # Host interface connected to target network (IP auto-detected)
  host_interface: "eth0"
  # Interface on target device
  target_interface: "eth3"
  # HTTP server port for serving artifacts
  http_port: 8000

serial:
  device: "/dev/ttyUSB0"
  baudrate: 115200

build:
  deploy_dir: "build/tmp/deploy/images/gateway-dk"

artifacts:
  firmware_qspi: "firmware-qspi.bin"
  firmware_emmc: "firmware-emmc.bin"
  rootfs: "mono-sdk-image-gateway-dk.rootfs.ext4"
