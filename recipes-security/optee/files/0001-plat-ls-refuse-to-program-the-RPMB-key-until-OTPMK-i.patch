From b43063e1cb151b839f91ce5f95e4f87b16d33a00 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Thu, 17 Sep 2026 20:38:57 +0200
Subject: [PATCH] plat-ls: refuse to program the RPMB key until OTPMK is blown

The eMMC accepts an RPMB authentication key exactly once for the life of
the part, and OP-TEE derives that key from the HUK, which CAAM takes from
the OTPMK fuse. With CFG_RPMB_WRITE_KEY enabled on a board whose OTPMK is
still blank, the first RPMB access therefore binds the part forever to a
key the SoC never kept secret -- and blowing the fuse afterwards changes
the HUK, leaving RPMB permanently unreachable. Every development kit would
destroy its own RPMB the first time secure storage was touched.

Implement the plat_rpmb_key_is_ready() hook for ls1046ardb so that cannot
happen. SNVS_HPSR bit 27 (OTPMK_ZERO) reads 1 while the fuse is all zeros,
which is a direct statement about the fuse and needs no cooperation from
firmware. The SNVS block is big-endian on this SoC, so the read is byte
swapped.

The imx, versal and zynqmp platforms gate on the SNVS state machine having
reached Trusted or Secure. That test does not carry over to Layerscape:
TF-A compiles snvs_init() only under TRUSTED_BOARD_BOOT and never calls
transition_snvs_trusted() anywhere, so the state machine is left wherever
reset put it and the gate would never open regardless of fuse state.

Upstream-Status: Pending

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 core/arch/arm/plat-ls/main.c            | 50 +++++++++++++++++++++++++
 core/arch/arm/plat-ls/platform_config.h |  1 +
 2 files changed, 51 insertions(+)

diff --git a/core/arch/arm/plat-ls/main.c b/core/arch/arm/plat-ls/main.c
index 7e013f9c2..a014f6066 100644
--- a/core/arch/arm/plat-ls/main.c
+++ b/core/arch/arm/plat-ls/main.c
@@ -49,6 +49,7 @@
 #include <sm/optee_smc.h>
 #include <kernel/tee_common_otp.h>
 #include <mm/core_mmu.h>
+#include <tee/tee_fs.h>
 
 #ifdef CFG_PL011
 static struct pl011_data console_data;
@@ -71,6 +72,9 @@ register_ddr(CFG_DRAM1_BASE, CFG_DRAM1_SIZE);
 #ifdef DCFG_BASE
 register_phys_mem_pgdir(MEM_AREA_IO_NSEC, DCFG_BASE, CORE_MMU_PGDIR_SIZE);
 #endif
+#if defined(SNVS_BASE) && defined(CFG_RPMB_FS)
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SNVS_BASE, CORE_MMU_PGDIR_SIZE);
+#endif
 
 #ifdef CFG_ARM32_core
 void plat_primary_init_early(void)
@@ -212,3 +216,49 @@ void boot_secondary_init_intc(void)
 {
 	gic_init_per_cpu();
 }
+
+#if defined(SNVS_BASE) && defined(CFG_RPMB_FS)
+#define SNVS_HPSR_OFFSET	0x14
+#define SNVS_HPSR_OTPMK_ZERO	BIT32(27)
+
+/*
+ * Gate programming of the eMMC RPMB authentication key on the OTPMK fuse
+ * being blown.
+ *
+ * That key is derived from the HUK, which CAAM takes from OTPMK, and the
+ * eMMC accepts it exactly once for the life of the part. Programming it
+ * while OTPMK is still blank therefore binds RPMB forever to a key this SoC
+ * never kept secret, and blowing the fuse afterwards leaves RPMB permanently
+ * unreachable. Refusing here keeps an unfused board -- every development kit
+ * -- from destroying its own RPMB on first use.
+ *
+ * SNVS_HPSR bit 27 (OTPMK_ZERO) reads 1 while the fuse is all zeros. The
+ * block is big-endian on this SoC, hence the byte swap. The imx, versal and
+ * zynqmp platforms gate on the SNVS state machine reaching Trusted or Secure
+ * instead; that test does not carry over, because nothing here transitions
+ * the state machine -- TF-A compiles snvs_init() only under
+ * TRUSTED_BOARD_BOOT and never calls transition_snvs_trusted() at all.
+ */
+bool plat_rpmb_key_is_ready(void)
+{
+	vaddr_t snvs = core_mmu_get_va(SNVS_BASE, MEM_AREA_IO_SEC,
+				       SNVS_HPSR_OFFSET + sizeof(uint32_t));
+	uint32_t hpsr = 0;
+
+	if (!snvs) {
+		EMSG("SNVS is not mapped, refusing to program the RPMB key");
+		return false;
+	}
+
+	hpsr = __builtin_bswap32(io_read32(snvs + SNVS_HPSR_OFFSET));
+	DMSG("SNVS HPSR: %#"PRIx32, hpsr);
+
+	if (hpsr & SNVS_HPSR_OTPMK_ZERO) {
+		EMSG("OTPMK is blank, refusing to program the RPMB key");
+		return false;
+	}
+
+	return true;
+}
+
+#endif /* SNVS_BASE && CFG_RPMB_FS */
diff --git a/core/arch/arm/plat-ls/platform_config.h b/core/arch/arm/plat-ls/platform_config.h
index 3924b5be5..d8f152670 100644
--- a/core/arch/arm/plat-ls/platform_config.h
+++ b/core/arch/arm/plat-ls/platform_config.h
@@ -69,6 +69,7 @@
 #define GICD_OFFSET			0x10000
 #define CAAM_BASE			0x01700000
 #define CAAM_SIZE			0x100000
+#define SNVS_BASE			0x01E90000
 #endif
 
 #if defined(PLATFORM_FLAVOR_ls1088ardb)
-- 
