From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Thu, 17 Sep 2026 20:38:57 +0200
Subject: [PATCH] plat-ls: refuse to program the RPMB key unless the boot was
 trusted

The eMMC accepts an RPMB authentication key exactly once for the life of
the part, and OP-TEE derives that key from the HUK, which CAAM derives
from its blob master key. That master key is the OTPMK only while the
SecMon is in the Trusted or Secure state; in Non-Secure the SEC
substitutes the Non-Volatile Test Key, a public constant identical in
every SoC. So the HUK is device-unique only under a boot the ROM
validated against SRKH -- ITS set, or RCW[SB_EN] with a valid signature
-- and a burned OTPMK on an unverified chain changes nothing. Keying RPMB
in that state binds the part forever to a key anyone can derive, and
enabling secure boot afterwards switches the master key, so the RPMB
becomes unreachable as well.

Implement the plat_rpmb_key_is_ready() hook for ls1046ardb to require
all of it: SNVS_HPSR SSM in Trusted (0xD) or Secure (0xF), OTPMK_ZERO
clear, a zero OTPMK syndrome in HPSR[24:16], and a clean OTPMK check in
SFP_SVHESR[18:10]. Both blocks are big-endian on this SoC, so the reads
are byte swapped. The refusal names the sampled values, which is the
only diagnostic that survives log level 1.

Sample the state at boot rather than when the gate is consulted. OP-TEE
caches the HUK from CAAM during boot, so the question is not what the
registers say now but what they said when the key in hand was derived.
Those differ, because HPSR reflects the SFP mirror registers and u-boot
runs afterwards: loading an OTPMK into the mirrors without programming
any fuse makes a blank part look fused. A gate reading HPSR at call time
would open on that and write the one-shot key under the earlier HUK. No
hardware bit separates a programmed fuse from a written mirror -- after
the boot-time fuse read they are the same thing -- so the distinction
has to be temporal.

This is the rule imx, versal and zynqmp apply, and it holds on
Layerscape too: TF-A never transitions the state machine, but the ROM
does, on a validated boot. An unfused board sits in Non-Secure (HPSR
0x88002b00, SSM 0xB), where the gate stays shut whatever the fuses hold.

The gate is compiled only for a flavour that defines SFP_BASE and
SNVS_BASE. Without them the weak default in tee_rpmb_fs.c returns true
and opens the gate silently, so a flavour that enables
CFG_RPMB_WRITE_KEY without providing the fuse state fails to build
instead.

Upstream-Status: Pending

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 core/arch/arm/plat-ls/main.c            | 116 ++++++++++++++++++++++++
 core/arch/arm/plat-ls/platform_config.h |   2 +
 2 files changed, 118 insertions(+)

diff --git a/core/arch/arm/plat-ls/main.c b/core/arch/arm/plat-ls/main.c
index 7e013f9c2..51e5d46a1 100644
--- a/core/arch/arm/plat-ls/main.c
+++ b/core/arch/arm/plat-ls/main.c
@@ -47,8 +47,11 @@
 #include <libfdt.h>
 #include <mm/core_memprot.h>
 #include <sm/optee_smc.h>
+#include <initcall.h>
 #include <kernel/tee_common_otp.h>
 #include <mm/core_mmu.h>
+#include <tee/tee_fs.h>
+#include <util.h>
 
 #ifdef CFG_PL011
 static struct pl011_data console_data;
@@ -71,6 +74,11 @@ register_ddr(CFG_DRAM1_BASE, CFG_DRAM1_SIZE);
 #ifdef DCFG_BASE
 register_phys_mem_pgdir(MEM_AREA_IO_NSEC, DCFG_BASE, CORE_MMU_PGDIR_SIZE);
 #endif
+#if defined(SFP_BASE) && defined(SNVS_BASE) && defined(CFG_RPMB_FS)
+/* SFP at +0, SNVS at +0x10000: one pgdir covers both. */
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SFP_BASE,
+			SNVS_BASE - SFP_BASE + SMALL_PAGE_SIZE);
+#endif
 
 #ifdef CFG_ARM32_core
 void plat_primary_init_early(void)
@@ -212,3 +220,111 @@ void boot_secondary_init_intc(void)
 {
 	gic_init_per_cpu();
 }
+
+#if defined(SFP_BASE) && defined(SNVS_BASE) && defined(CFG_RPMB_FS)
+#define SFP_SVHESR_OFFSET		0x24
+#define SFP_SVHESR_OTPMK_MASK		GENMASK_32(18, 10)
+#define SNVS_HPSR_OFFSET		0x14
+#define SNVS_HPSR_OTPMK_ZERO		BIT32(27)
+#define SNVS_HPSR_OTPMK_SYNDROME	GENMASK_32(24, 16)
+#define SNVS_HPSR_SSM_ST_MASK		GENMASK_32(11, 8)
+#define SNVS_HPSR_SSM_ST_TRUSTED	SHIFT_U32(0xd, 8)
+#define SNVS_HPSR_SSM_ST_SECURE		SHIFT_U32(0xf, 8)
+
+static bool huk_unique_at_boot;
+static uint32_t hpsr_at_boot;
+static uint32_t svhesr_at_boot;
+
+/*
+ * Sample the fuse state once, here, rather than when the gate is consulted.
+ *
+ * OP-TEE reads the HUK from CAAM during boot and caches it, so the question
+ * the gate has to answer is not "is OTPMK blown now" but "was it blown when
+ * the key now in hand was derived". Those differ: SNVS_HPSR reports what the
+ * SFP mirror registers hold, and u-boot -- which runs after this -- can load
+ * an OTPMK into the mirrors without programming a single fuse. A gate reading
+ * HPSR at call time would see that and open, and OP-TEE would then write the
+ * eMMC's one-shot RPMB key derived from the earlier, unfused HUK. There is no
+ * second chance at that key, and no hardware bit distinguishing a programmed
+ * fuse from a written mirror, because after the boot-time fuse read they are
+ * the same thing.
+ *
+ * Sampling at boot makes the gate and the HUK consistent by construction:
+ * both are fixed before anything else can touch the mirrors.
+ *
+ * Blank is the obvious refusal. A non-zero Hamming syndrome, from SNVS in
+ * HPSR or from the SFP in SVHESR, means the key SNVS holds is not the one
+ * the fuses were meant to carry, and a permanent RPMB key derived from it
+ * is no better than one derived from zeros.
+ *
+ * The SecMon state is the other half, and the one that matters most. The
+ * SEC derives its blob master key from the OTPMK only in the Trusted and
+ * Secure states; in Non-Secure it substitutes the Non-Volatile Test Key, a
+ * public constant identical in every SoC. A burned OTPMK on an unverified
+ * boot chain therefore yields a HUK that is the same on every unit, and an
+ * RPMB key derived from it is no secret at all. Only a boot the ROM
+ * validated against SRKH -- ITS set, or RCW[SB_EN] with a valid signature
+ * -- reaches Trusted; TF-A never transitions the state machine, and an
+ * unfused board sits in Non-Secure (HPSR 0x88002b00, SSM 0xB). This is the
+ * rule imx, versal and zynqmp apply, for the same reason.
+ *
+ * Both blocks are big-endian on this SoC, hence the byte swaps.
+ */
+static TEE_Result sample_otpmk_state(void)
+{
+	vaddr_t sfp = core_mmu_get_va(SFP_BASE, MEM_AREA_IO_SEC,
+				      SFP_SVHESR_OFFSET + sizeof(uint32_t));
+	vaddr_t snvs = core_mmu_get_va(SNVS_BASE, MEM_AREA_IO_SEC,
+				       SNVS_HPSR_OFFSET + sizeof(uint32_t));
+	uint32_t ssm = 0;
+
+	if (!sfp || !snvs) {
+		EMSG("SFP/SNVS not mapped, treating OTPMK as blank");
+		return TEE_SUCCESS;
+	}
+
+	svhesr_at_boot = __builtin_bswap32(io_read32(sfp + SFP_SVHESR_OFFSET));
+	hpsr_at_boot = __builtin_bswap32(io_read32(snvs + SNVS_HPSR_OFFSET));
+	DMSG("At boot: SNVS_HPSR %#"PRIx32", SFP_SVHESR %#"PRIx32,
+	     hpsr_at_boot, svhesr_at_boot);
+
+	ssm = hpsr_at_boot & SNVS_HPSR_SSM_ST_MASK;
+	huk_unique_at_boot =
+		(ssm == SNVS_HPSR_SSM_ST_TRUSTED ||
+		 ssm == SNVS_HPSR_SSM_ST_SECURE) &&
+		!(hpsr_at_boot & (SNVS_HPSR_OTPMK_ZERO |
+				  SNVS_HPSR_OTPMK_SYNDROME)) &&
+		!(svhesr_at_boot & SFP_SVHESR_OTPMK_MASK);
+
+	return TEE_SUCCESS;
+}
+
+service_init(sample_otpmk_state);
+
+/*
+ * Refuse the one-shot eMMC RPMB key write unless the HUK was device-unique
+ * at boot: a trusted SecMon and a sound, blown OTPMK.
+ *
+ * That key is derived from the HUK and the eMMC accepts it exactly once for
+ * the life of the part, so programming it while OTPMK is blank binds RPMB
+ * forever to a key this SoC never kept secret, and blowing the fuse
+ * afterwards leaves RPMB permanently unreachable.
+ */
+bool plat_rpmb_key_is_ready(void)
+{
+	if (!huk_unique_at_boot) {
+		EMSG("HUK not device-unique at boot (SNVS_HPSR %#"PRIx32", SFP_SVHESR %#"PRIx32"): SecMon must be Trusted/Secure and OTPMK blown and sound, refusing to program the RPMB key",
+		     hpsr_at_boot, svhesr_at_boot);
+		return false;
+	}
+
+	return true;
+}
+#elif defined(CFG_RPMB_WRITE_KEY)
+/*
+ * Without the fuse state, the weak plat_rpmb_key_is_ready() in
+ * tee_rpmb_fs.c returns true and keys the eMMC under whatever HUK this
+ * build derived, blank OTPMK included. Refuse to build rather than to run.
+ */
+#error "CFG_RPMB_WRITE_KEY needs SFP_BASE and SNVS_BASE for this flavour"
+#endif /* SFP_BASE && SNVS_BASE && CFG_RPMB_FS */
diff --git a/core/arch/arm/plat-ls/platform_config.h b/core/arch/arm/plat-ls/platform_config.h
index 3924b5be5..a6b60e720 100644
--- a/core/arch/arm/plat-ls/platform_config.h
+++ b/core/arch/arm/plat-ls/platform_config.h
@@ -69,6 +69,8 @@
 #define GICD_OFFSET			0x10000
 #define CAAM_BASE			0x01700000
 #define CAAM_SIZE			0x100000
+#define SFP_BASE			0x01E80000
+#define SNVS_BASE			0x01E90000
 #endif
 
 #if defined(PLATFORM_FLAVOR_ls1088ardb)
-- 
2.47.3

