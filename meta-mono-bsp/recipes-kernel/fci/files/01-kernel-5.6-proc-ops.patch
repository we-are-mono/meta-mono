From: Tomaz Zaman <tomaz@mono.si>
Date: Mon, 12 Jan 2026 12:00:00 +0100
Subject: [PATCH] fci: Add proc_ops support for kernel 5.6+

Kernel 5.6 replaced file_operations with proc_ops for /proc entries.
Add conditional compilation to support both old and new APIs.

Upstream-Status: Inappropriate [kernel compatibility fix]
Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
diff --git a/fci.c b/fci.c
index 039ba47..403dbdc 100644
--- a/fci.c
+++ b/fci.c
@@ -581,6 +581,14 @@ static int fci_proc_open(struct inode *inode, struct  file *file)
 	return single_open(file, fci_proc_single_open, NULL);
 }

+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5,6,0)
+static const struct proc_ops fci_proc_fops = {
+	.proc_open = fci_proc_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+#else
 struct file_operations fci_proc_fops = {
 	.owner = THIS_MODULE,
 	.open = fci_proc_open,
@@ -588,6 +596,7 @@ struct file_operations fci_proc_fops = {
 	.llseek = seq_lseek,
 	.release = single_release,
 };
+#endif

 #else
 /**
