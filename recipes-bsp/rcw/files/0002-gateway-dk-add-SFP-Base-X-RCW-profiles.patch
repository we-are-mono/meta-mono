+DDR_REFCLK_SEL=1                  /* 0=DDRCLK, 1=DIFF_SYSCLK, both should work */
+DRAM_LAT=1                        /* b01 for latencies, higher than 8-8-8 */
+
+/* boot settings */
+PBI_SRC=4                         /* QSPI (b0100) */
+SB_EN=0                           /* secure boot is not enabled */
+
+/* pin multiplexing, all IFC_* options set the pins to QSPI */
+IFC_GRP_A_EXT=1
+IFC_GRP_D_EXT=1
+IFC_GRP_E1_EXT=0
+IFC_GRP_E1_BASE=1
+IFC_GRP_F_EXT=1
+IRQ_OUT=1                         /* Mandatory */
+IRQ_EXT=0                         /* We want IRQ/GPIO pins instead of FTM */
+IRQ_BASE=1                        /* All GPIO1[23:31] pins set to IRQ */
+IIC2_EXT=0                        /* We want I2C pins */
+EC1=1                             /* We want GPIO3, not EC1 */
+EC2=1                             /* We want GPIO3, not EC2 */
+EM1=1                             /* We want GPIO3, not EM1 */
+UART_BASE=6                       /* b110, all UART pins assigned to UART */
+SDHC_BASE=0
+SPI_EXT=2                         /* We need GPIO2_02 for SFP clock selector */
+SPI_BASE=0
+USB_DRVVBUS=0
+USB_PWRFAULT=0
+
+.pbi
+// Set the BOOTLOCPTR
+write 0x570600, 0x00000000
+write 0x570604, 0x10000000
+.end
+
+.pbi
+// Make sure to use IIC3_SCL and IIC3_SDA (GPIO_4[10|11] by default)
+write 0x57040c, 0x00000000
+.end
+
