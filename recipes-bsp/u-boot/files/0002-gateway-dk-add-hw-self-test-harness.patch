diff --git a/board/mono/gateway_dk/setup/hw_test.c b/board/mono/gateway_dk/setup/hw_test.c
new file mode 100644
index 00000000000..3e81fd8bc64
--- /dev/null
+++ b/board/mono/gateway_dk/setup/hw_test.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <vsprintf.h>
+#include "hw_test.h"
+
+int hw_test_fail(struct hw_test_ctx *ctx, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (ctx) {
+		va_start(ap, fmt);
+		vsnprintf(ctx->details, sizeof(ctx->details), fmt, ap);
+		va_end(ap);
+	}
+	return -1;
+}
+
+int hw_test_pass(struct hw_test_ctx *ctx, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (ctx) {
+		va_start(ap, fmt);
+		vsnprintf(ctx->details, sizeof(ctx->details), fmt, ap);
+		va_end(ap);
+	}
+	return 0;
+}
+
+int hw_test_warn(struct hw_test_ctx *ctx, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (ctx) {
+		va_start(ap, fmt);
+		vsnprintf(ctx->details, sizeof(ctx->details), fmt, ap);
+		va_end(ap);
+		ctx->warned = 1;
+	}
+	return 0;
+}
+
+static void hw_test_print_line(const char *tag, const char *name,
+			       const char *details)
+{
+	if (details && details[0])
+		printf("%s %-*s %s\n", tag, HW_TEST_LABEL_WIDTH, name, details);
+	else
+		printf("%s %-*s\n", tag, HW_TEST_LABEL_WIDTH, name);
+}
+
+void hw_test_print_pass(const char *name, const char *details)
+{
+	hw_test_print_line(HW_TEST_TAG_PASS, name, details);
+}
+
+void hw_test_print_fail(const char *name, const char *details)
+{
+	hw_test_print_line(HW_TEST_TAG_FAIL, name, details);
+}
+
+void hw_test_print_warn(const char *name, const char *details)
+{
+	hw_test_print_line(HW_TEST_TAG_WARN, name, details);
+}
+
+void hw_tests_print_banner(const char *title)
+{
+	printf("\n" HW_TEST_C_BOLD "%s:" HW_TEST_C_RESET "\n", title);
+}
+
+void hw_tests_print_summary(struct hw_test_result r)
+{
+	const char *tag = r.failed ? HW_TEST_TAG_SUMMARY_FAIL
+				   : HW_TEST_TAG_SUMMARY_PASS;
+
+	printf("%s %-*s %u passed, %u failed",
+	       tag, HW_TEST_LABEL_WIDTH, "Self-test", r.passed, r.failed);
+	if (r.warned)
+		printf(", %u warning%s", r.warned, r.warned == 1 ? "" : "s");
+	printf("\n\n");
+}
+
+struct hw_test_result hw_tests_run(const struct hw_test *tests, size_t count)
+{
+	struct hw_test_result r = { 0, 0, 0 };
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		struct hw_test_ctx ctx = { .details = { 0 }, .printed = 0,
+					   .warned = 0 };
+		int ret = tests[i].run(&ctx);
+
+		if (ret == 0) {
+			r.passed++;
+			if (ctx.warned)
+				r.warned++;
+		} else {
+			r.failed++;
+		}
+
+		if (ctx.printed)
+			continue;
+
+		if (ret != 0)
+			hw_test_print_fail(tests[i].name, ctx.details);
+		else if (ctx.warned)
+			hw_test_print_warn(tests[i].name, ctx.details);
+		else
+			hw_test_print_pass(tests[i].name, ctx.details);
+	}
+
+	return r;
+}
diff --git a/board/mono/gateway_dk/setup/hw_test.h b/board/mono/gateway_dk/setup/hw_test.h
new file mode 100644
index 00000000000..a2eab4eb375
--- /dev/null
+++ b/board/mono/gateway_dk/setup/hw_test.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ *
+ * Tiny harness for the on-board hardware self-tests run from
+ * misc_init_r(). Each test fills in ctx->details and returns 0 on
+ * pass, non-zero on fail; the harness prints one bracket-prefixed
+ * "[ OK ] / [FAIL]" line per test. A test can also pass with a
+ * warning through hw_test_warn(): the line is tagged "[WARN]" and the
+ * summary counts it, but the run still passes, so the LED and the
+ * kernel see a pass. That is for permanent states worth seeing on
+ * every boot that nobody can act on, such as a damaged OTPMK. Tests
+ * that need richer per-item output (e.g. per-rail voltage readouts)
+ * call the print helpers below directly and set ctx->printed so the
+ * harness suppresses its own summary line.
+ */
+
+#ifndef HW_TEST_H
+#define HW_TEST_H
+
+#include <linux/types.h>
+#include <linux/stddef.h>
+
+/*
+ * Display constants, kept here so styling tweaks are one-stop. The PASS,
+ * FAIL and WARN tags are six visible columns wide regardless of the
+ * embedded ANSI escape sequences; mind that when changing them.
+ */
+#define HW_TEST_C_GREEN		"\033[32m"
+#define HW_TEST_C_RED		"\033[31m"
+#define HW_TEST_C_AMBER	"\033[38;2;255;165;0m"	/* the recovery prompt's orange */
+#define HW_TEST_C_BOLD		"\033[1m"
+#define HW_TEST_C_DIM		"\033[2m"
+#define HW_TEST_C_RESET		"\033[0m"
+
+#define HW_TEST_TAG_PASS	"[ " HW_TEST_C_GREEN "OK" HW_TEST_C_RESET " ]"
+#define HW_TEST_TAG_FAIL	"[" HW_TEST_C_RED "FAIL" HW_TEST_C_RESET "]"
+#define HW_TEST_TAG_WARN	"[" HW_TEST_C_AMBER "WARN" HW_TEST_C_RESET "]"
+
+/*
+ * Distinct tags for the aggregate summary line so it visually carries
+ * a verdict ("did the whole thing pass?") rather than looking like
+ * just another test entry. Same six visible columns as the per-test
+ * tags above, so alignment is preserved.
+ */
+#define HW_TEST_TAG_SUMMARY_PASS	"[" HW_TEST_C_GREEN "PASS" HW_TEST_C_RESET "]"
+#define HW_TEST_TAG_SUMMARY_FAIL	"[" HW_TEST_C_RED "FAIL" HW_TEST_C_RESET "]"
+
+#define HW_TEST_LABEL_WIDTH	20	/* visible chars; controls alignment */
+
+#define HW_TEST_DETAILS_MAX	80
+
+struct hw_test_ctx {
+	char details[HW_TEST_DETAILS_MAX];
+	int printed;	/* set by tests that emit their own per-item lines */
+	int warned;	/* set by hw_test_warn(): passed, but worth a look */
+};
+
+typedef int (*hw_test_fn)(struct hw_test_ctx *ctx);
+
+struct hw_test {
+	const char *name;
+	hw_test_fn run;
+};
+
+/* Aggregate counts returned by hw_tests_run(); warned is a subset of passed */
+struct hw_test_result {
+	unsigned int passed;
+	unsigned int failed;
+	unsigned int warned;
+};
+
+/*
+ * Run every test in the table. The harness prints one bracket-prefixed
+ * line per test unless the test set ctx->printed (in which case it has
+ * already emitted whatever output it wants).
+ */
+struct hw_test_result hw_tests_run(const struct hw_test *tests, size_t count);
+
+/* Banner / footer printers used to bracket the self-test phase. */
+void hw_tests_print_banner(const char *title);
+void hw_tests_print_summary(struct hw_test_result r);
+
+/*
+ * Print a bracket-prefixed line directly. Used by tests that emit
+ * per-item output (voltage rails). When a test calls these it MUST
+ * also set ctx->printed = 1 so the harness skips its own summary line.
+ */
+void hw_test_print_pass(const char *name, const char *details);
+void hw_test_print_fail(const char *name, const char *details);
+void hw_test_print_warn(const char *name, const char *details);
+
+/*
+ * Helpers for tests to populate ctx->details. fail returns -1, pass and
+ * warn return 0, so the test body can write `return hw_test_fail(ctx, ...);`.
+ * warn also marks the context so the harness tags the line [WARN].
+ */
+int hw_test_fail(struct hw_test_ctx *ctx, const char *fmt, ...)
+	__attribute__((format(printf, 2, 3)));
+int hw_test_pass(struct hw_test_ctx *ctx, const char *fmt, ...)
+	__attribute__((format(printf, 2, 3)));
+int hw_test_warn(struct hw_test_ctx *ctx, const char *fmt, ...)
+	__attribute__((format(printf, 2, 3)));
+
+#endif /* HW_TEST_H */
diff --git a/board/mono/gateway_dk/setup/i2c_helpers.c b/board/mono/gateway_dk/setup/i2c_helpers.c
new file mode 100644
index 00000000000..f6a09d69214
--- /dev/null
+++ b/board/mono/gateway_dk/setup/i2c_helpers.c
@@ -0,0 +1,21 @@
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+
+int setup_i2c_muxed_device(int bus, uint8_t mux_addr, uint8_t channel, 
+						   uint8_t dev_addr, struct udevice **dev)
+{
+	struct udevice *mux_dev;
+	int ret;
+	
+	ret = i2c_get_chip_for_busnum(bus, mux_addr, 1, &mux_dev);
+	if (ret)
+		return ret;
+	
+	ret = dm_i2c_write(mux_dev, 0x00, &channel, 1);
+	if (ret)
+		return ret;
+	
+	return i2c_get_chip_for_busnum(bus, dev_addr, 1, dev);
+}
