-/* Unlock EEPROM by driving GPIO3_00 low */
+/*
+ * Drive WP as an output, high to lock the EEPROM and low to unlock it. This
+ * goes through the GPIO driver rather than the bank's registers: the driver
+ * keeps its own copy of the data register and writes all of it back whenever
+ * it sets any line on the bank, which the SFP port LEDs do ten times a
+ * second. A level written behind its back would be undone within 100 ms.
+ */
+static int eeprom_set_write_protect(bool protect)
+{
+	struct gpio_desc wp = { .offset = EEPROM_WP_GPIO };
+	int ret;
+
+	ret = uclass_get_device_by_name(UCLASS_GPIO, EEPROM_WP_GPIO_BANK,
+					&wp.dev);
+	if (ret)
+		return ret;
+
+	ret = dm_gpio_request(&wp, "eeprom-wp");
+	if (ret)
+		return ret;
+
+	ret = dm_gpio_set_dir_flags(&wp, GPIOD_IS_OUT |
+				    (protect ? GPIOD_IS_OUT_ACTIVE : 0));
+	dm_gpio_free(wp.dev, &wp);
+
+	return ret;
+}
+
 static void unlock_eeprom(void)
 {
-	u32 gpio_dir, gpio_dat;
-	
-	/* Read current values */
-	gpio_dir = in_be32((void *)(GPIO3_BASE + GPIO3_GPDIR));
-	gpio_dat = in_be32((void *)(GPIO3_BASE + GPIO3_GPDAT));
-	
-	/* Set GPIO3_00 as output (set bit 31) */
-	gpio_dir |= 0x80000000;
-	out_be32((void *)(GPIO3_BASE + GPIO3_GPDIR), gpio_dir);
-	
-	/* Drive GPIO3_00 low (clear bit 31) to unlock EEPROM */
-	gpio_dat &= ~0x80000000;
-	out_be32((void *)(GPIO3_BASE + GPIO3_GPDAT), gpio_dat);
-	
-	/* Read back to ensure write completed */
-	(void)in_be32((void *)(GPIO3_BASE + GPIO3_GPDAT));
-	
+	int ret = eeprom_set_write_protect(false);
+
+	if (ret)
+		printf("Warning: could not drive EEPROM WP low (%d), writes will fail\n",
+		       ret);
+
 	udelay(10000);
 }
 
-/* Lock EEPROM by driving GPIO3_00 high */
 static void lock_eeprom(void)
 {
-	u32 gpio_dat;
-	
-	/* Read current value */
-	gpio_dat = in_be32((void *)(GPIO3_BASE + GPIO3_GPDAT));
-	
-	/* Drive GPIO3_00 high (set bit 31) to lock EEPROM */
-	gpio_dat |= 0x80000000;
-	out_be32((void *)(GPIO3_BASE + GPIO3_GPDAT), gpio_dat);
+	int ret = eeprom_set_write_protect(true);
+
+	if (ret)
+		printf("Warning: could not drive EEPROM WP high (%d), EEPROM is left writable\n",
+		       ret);
 }
 
 /* Get EEPROM device */
diff --git a/board/mono/gateway_dk/setup/sfp_led.c b/board/mono/gateway_dk/setup/sfp_led.c
new file mode 100644
index 00000000000..0a9a28e24b9
--- /dev/null
+++ b/board/mono/gateway_dk/setup/sfp_led.c
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SFP+ port LEDs.
+ *
+ * Module presence comes from the cage's MOD_DEF0 line, link state from the
+ * MAC's XFI PCS and activity from the MAC's own frame counters -- the same
+ * three things the recovery kernel's sfp-led driver shows. None of them goes
+ * near i2c, deliberately: a module caught mid-transfer by a reset holds SDA
+ * low until it loses power, and a port whose module has done that must still
+ * light its LEDs -- as must its neighbour, which shares the bus.
+ *
+ * No module: both LEDs off. Module without link: solid orange. Link up:
+ * green, with orange blinking on frames. The counters sit in the MAC, so the
+ * blink follows everything the wire delivers rather than only the transfers
+ * U-Boot itself started.
+ *
+ * The 10G ports are fixed-link, so nothing configures the XFI PCS and it
+ * reports no link however good the fibre is until its MAC is opened. Both
+ * MACs are therefore opened here, which costs no more than the opens
+ * themselves: FMan and its microcode come up on every boot regardless, when
+ * the ethernet devices are enumerated. The opened MACs are stopped again
+ * before the kernel starts, see mono_sfp_led_stop().
+ *
+ * Copyright 2026 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <cyclic.h>
+#include <dm.h>
+#include <errno.h>
+#include <fsl_memac.h>
+#include <miiphy.h>
+#include <net.h>
+#include <stdio.h>
+#include <asm/gpio.h>
+#include <asm/io.h>
+#include <dm/device-internal.h>
+#include <dm/ofnode.h>
+#include <linux/mdio.h>
+
+#define SFP_LED_POLL_INTERVAL_US	100000
+#define SFP_LED_MAX_PORTS		2
+
+/* Each XFI PCS sits alone on its MAC's internal MDIO bus. */
+#define SFP_LED_PCS_ADDR		0
+
+struct sfp_led_port {
+	const char *eth_name;
+	struct gpio_desc present;
+	struct gpio_desc link_led;
+	struct gpio_desc activity_led;
+	struct udevice *pcs;
+	struct udevice *eth;
+	struct memac *mac;
+	u32 last_frames;
+	bool activity_on;
+	bool had_link;
+};
+
+static struct sfp_led_port sfp_led_ports[SFP_LED_MAX_PORTS];
+static int sfp_led_count;
+static struct cyclic_info sfp_led_cyclic;
+
+static int sfp_led_setup_port(ofnode node, struct sfp_led_port *port)
+{
+	const char *pcs_name;
+	int ret;
+
+	port->eth_name = ofnode_read_string(node, "mono,eth-name");
+	pcs_name = ofnode_read_string(node, "mono,pcs-name");
+	if (!port->eth_name || !pcs_name)
+		return -EINVAL;
+
+	/*
+	 * MOD_DEF0 is asserted by the module itself and pulled up when the
+	 * cage is empty. The dts carries the polarity, so this reads
+	 * logically.
+	 */
+	ret = gpio_request_by_name_nodev(node, "mod-def0-gpios", 0,
+					 &port->present, GPIOD_IS_IN);
+	if (ret)
+		return ret;
+
+	ret = gpio_request_by_name_nodev(node, "link-gpios", 0,
+					 &port->link_led, GPIOD_IS_OUT);
+	if (ret)
+		return ret;
+
+	ret = gpio_request_by_name_nodev(node, "activity-gpios", 0,
+					 &port->activity_led, GPIOD_IS_OUT);
+	if (ret)
+		return ret;
+
+	return uclass_get_device_by_name(UCLASS_MDIO, pcs_name, &port->pcs);
+}
+
+/*
+ * Opening the MAC is what takes the XFI PCS out of its reset state, and it
+ * leaves the MAC counting frames, which is where the activity blink comes
+ * from. A port with an empty cage opens just as readily: the path touches
+ * neither i2c nor MOD_DEF0, and a fixed-link port reports link to phylib
+ * without waiting for autonegotiation, so nothing here can stall on a
+ * missing module.
+ */
+static void sfp_led_start_mac(struct sfp_led_port *port)
+{
+	struct udevice *dev;
+	fdt_addr_t addr;
+	int ret;
+
+	ret = uclass_get_device_by_name(UCLASS_ETH, port->eth_name, &dev);
+	if (!ret)
+		ret = eth_start_udev(dev);
+	if (ret) {
+		printf("sfp-led: %s did not start (%d), link will read down\n",
+		       port->eth_name, ret);
+		return;
+	}
+
+	port->eth = dev;
+	addr = ofnode_get_addr(dev_ofnode(dev));
+	if (addr == FDT_ADDR_T_NONE)
+		printf("sfp-led: %s has no address, activity will not blink\n",
+		       port->eth_name);
+	else
+		port->mac = (struct memac *)(uintptr_t)addr;
+}
+
+/*
+ * Only the lower halves of the two counters, and only ever compared against
+ * the previous sample: the halves cannot be read as one, and a wrap costs at
+ * worst a single missed blink.
+ */
+static u32 sfp_led_frames(struct sfp_led_port *port)
+{
+	if (!port->mac)
+		return 0;
+
+	return in_be32(&port->mac->rx_frame_l) + in_be32(&port->mac->tx_frame_l);
+}
+
+static bool sfp_led_link(struct sfp_led_port *port)
+{
+	int status;
+
+	/*
+	 * The link indication latches low, so the first read after any drop
+	 * returns the stale state and the second returns the live one.
+	 */
+	status = dm_mdio_read(port->pcs, SFP_LED_PCS_ADDR, MDIO_MMD_PCS,
+			      MDIO_STAT1);
+	if (status >= 0 && status != 0xffff)
+		status = dm_mdio_read(port->pcs, SFP_LED_PCS_ADDR, MDIO_MMD_PCS,
+				      MDIO_STAT1);
+
+	/* The FMan MDIO driver returns all ones for an unanswered read. */
+	if (status < 0 || status == 0xffff)
+		return false;
+
+	return !!(status & MDIO_STAT1_LSTATUS);
+}
+
+static void sfp_led_update(struct sfp_led_port *port, bool present, bool link)
+{
+	u32 frames;
+
+	if (!link) {
+		/* Solid, so a module that cannot link is still visible. */
+		port->activity_on = present;
+		port->had_link = false;
+	} else {
+		frames = sfp_led_frames(port);
+
+		if (!port->had_link)
+			port->activity_on = false; /* Old traffic is not new. */
+		else if (frames != port->last_frames)
+			port->activity_on = !port->activity_on;
+		else
+			port->activity_on = false;
+
+		port->last_frames = frames;
+		port->had_link = true;
+	}
+
+	dm_gpio_set_value(&port->link_led, link);
+	dm_gpio_set_value(&port->activity_led, port->activity_on);
+}
+
+static void sfp_led_poll(struct cyclic_info *c)
+{
+	int i;
+
+	for (i = 0; i < sfp_led_count; i++) {
+		struct sfp_led_port *port = &sfp_led_ports[i];
+		bool present = dm_gpio_get_value(&port->present) > 0;
+
+		sfp_led_update(port, present, present && sfp_led_link(port));
+	}
+}
+
+void mono_sfp_led_init(void)
+{
+	ofnode parent, node;
+	int ret;
+
+	parent = ofnode_by_compatible(ofnode_null(), "mono,sfp-led");
+	if (!ofnode_valid(parent))
+		return;
+
+	ofnode_for_each_subnode(node, parent) {
+		struct sfp_led_port *port;
+
+		if (sfp_led_count == SFP_LED_MAX_PORTS)
+			break;
+
+		port = &sfp_led_ports[sfp_led_count];
+		ret = sfp_led_setup_port(node, port);
+		if (ret) {
+			printf("sfp-led: %s unusable (%d)\n",
+			       ofnode_get_name(node), ret);
+			continue;
+		}
+
+		sfp_led_start_mac(port);
+		sfp_led_count++;
+	}
+
+	if (!sfp_led_count)
+		return;
+
+	cyclic_register(&sfp_led_cyclic, sfp_led_poll,
+			SFP_LED_POLL_INTERVAL_US, "sfp-led");
+}
+
+/*
+ * An opened MAC keeps receiving: FMan writes each frame into buffers and
+ * descriptors that sit in U-Boot's heap, which the kernel takes over as
+ * ordinary memory, and nothing else stops these MACs -- eth_fman is not
+ * among the drivers dm_remove_devices_active() removes. A frame arriving
+ * after the handoff would land in whatever the kernel had put there, until
+ * the kernel's own FMan driver resets the block. Removing the device runs
+ * the driver's stop, which disables the MAC and both of its ports.
+ */
+void mono_sfp_led_stop(void)
+{
+	int i;
+
+	cyclic_unregister(&sfp_led_cyclic);
+
+	for (i = 0; i < sfp_led_count; i++) {
+		struct sfp_led_port *port = &sfp_led_ports[i];
+
+		if (port->eth)
+			device_remove(port->eth, DM_REMOVE_NORMAL);
+	}
+}
