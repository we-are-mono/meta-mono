#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
#include "fsl-ls1046a.dtsi"

/ {
	model = "Mono Gateway Development Kit";

	aliases {
		spi0 = &qspi;
		serial0 = &duart0;
		serial1 = &duart1;
		mdio0 = &mdio;
        i2c0 = &i2c0;
        i2c1 = &i2c1;
        i2c2 = &i2c2;
        i2c3 = &i2c3;  /* Force i2c@21b0000 to always be bus 3 */
    };

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Port LEDs driven from MOD_DEF0 and the MAC's XFI PCS. Each port
	 * names the ethernet device whose MAC has to be open before its PCS
	 * reports link, and the internal MDIO bus that PCS answers on.
	 */
	sfp-leds {
		compatible = "mono,sfp-led";

		port0 {
			mono,eth-name = "fm1-mac9";
			mono,pcs-name = "mdio@f1000";
			mod-def0-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
			link-gpios = <&gpio2 17 GPIO_ACTIVE_HIGH>;
			activity-gpios = <&gpio2 18 GPIO_ACTIVE_HIGH>;
		};

		port1 {
			mono,eth-name = "fm1-mac10";
			mono,pcs-name = "mdio@f3000";
			mod-def0-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
			link-gpios = <&gpio2 15 GPIO_ACTIVE_HIGH>;
			activity-gpios = <&gpio2 16 GPIO_ACTIVE_HIGH>;
		};
	};
};

&duart0 {
	bootph-all;
	status = "okay";
};

&duart1 {
	bootph-all;
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
    status = "okay";

    i2c_mux: i2c-mux@70 {
        compatible = "nxp,pca9546";
        #address-cells = <1>;
        #size-cells = <0>;
        reg = <0x70>;

        i2c@2 {  /* Channel 2 */
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <2>;

            pcf2131: rtc@53 {
                compatible = "nxp,pcf2131";
                reg = <0x53>;
            };
        };
    };
};

&i2c3 {
    status = "okay";

    eeprom@50 {
        compatible = "atmel,24c32";   /* AT24CS32 - 32Kbit (4KB) */
        reg = <0x50>;
        pagesize = <32>;              /* 32-byte page writes */
        size = <4096>;                /* 4KB (32Kbit) total size */
    };
};

&usb1 {
	status = "disabled";
};

&usb2 {
	status = "disabled";
};

&qspi {
	status = "okay";

	mt25qu512abb: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		reg = <0>;
		spi-tx-bus-width = <1>;
        spi-rx-bus-width = <4>;
	};

};

&esdhc {
	mmc-hs200-1_8v;
	bus-width = <4>;
	status = "okay";
};

#include "fsl-ls1046-post.dtsi"

&fman0 {
	ethernet@e0000 {
		status = "disabled";
	};

	ethernet@e4000 {
		status = "disabled";
	};

	ethernet@e6000 {
		status = "disabled";
	};

	ethernet@e8000 {
		phy-handle = <&sgmii_phy0>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@ea000 {
		phy-handle = <&sgmii_phy1>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@e2000 {
		phy-handle = <&sgmii_phy2>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@f0000 {
		fixed-link = <0 1 10000 0 0>;
		phy-connection-type = "xgmii";
		status = "okay";
	};

	ethernet@f2000 {
		fixed-link = <0 1 10000 0 0>;
		phy-connection-type = "xgmii";
		status = "okay";
	};

	mdio@fc000 {
		status = "disabled";
	};

	mdio: mdio@fd000 {
		sgmii_phy0: ethernet-phy@0 {
			reg = <0x0>;
		};

		sgmii_phy1: ethernet-phy@1 {
			reg = <0x1>;
		};

		sgmii_phy2: ethernet-phy@2 {
			reg = <0x2>;
		};
	};
};
