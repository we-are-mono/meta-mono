diff --git a/board/mono/gateway_dk/setup/clock_gen.c b/board/mono/gateway_dk/setup/clock_gen.c
new file mode 100644
index 00000000000..836930d1dc1
--- /dev/null
+++ b/board/mono/gateway_dk/setup/clock_gen.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define CLOCKGEN_ADDR		0x69
+#define I2C_BUS			0
+#define I2C_MUX_CHANNEL		0x01
+
+/* Register offsets */
+#define REG_SLEW_RATE2		0x04
+#define REG_REV_VENDOR_ID	0x07
+
+/* Expected values */
+#define EXPECTED_DEVICE_ID	0x11	/* Rev 0x1, Vendor 0x1 */
+
+/* Sys_CCB frequency values (bits 3:2 of register 0x04) */
+#define CCB_FREQ_66_66		0
+#define CCB_FREQ_100		1
+#define CCB_FREQ_80		2
+#define CCB_FREQ_83_33		3
+
+static const char *get_ccb_freq_string(uint8_t fs_bits)
+{
+	switch (fs_bits) {
+	case CCB_FREQ_66_66:	return "66.66 MHz";
+	case CCB_FREQ_100:	return "100 MHz";
+	case CCB_FREQ_80:	return "80 MHz";
+	case CCB_FREQ_83_33:	return "83.33 MHz";
+	default:		return "Unknown";
+	}
+}
+
+int test_6v49205b_clkgen(struct hw_test_ctx *ctx)
+{
+	struct udevice *clkgen_dev;
+	uint8_t buf[16];
+	uint8_t device_id;
+	uint8_t ccb_freq_bits;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   I2C_MUX_CHANNEL, CLOCKGEN_ADDR, &clkgen_dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	if (dm_i2c_read(clkgen_dev, 0x00, buf, sizeof(buf)))
+		return hw_test_fail(ctx, "Failed to read registers");
+
+	/* SMBus returns byte count as first byte, so actual data starts at buf[1] */
+	device_id = buf[REG_REV_VENDOR_ID + 1];
+	if (device_id != EXPECTED_DEVICE_ID)
+		return hw_test_fail(ctx, "Device ID 0x%02X, expected 0x%02X",
+				    device_id, EXPECTED_DEVICE_ID);
+
+	/* Extract FS1:FS0 bits (bits 3:2) from REG_SLEW_RATE2 */
+	ccb_freq_bits = (buf[REG_SLEW_RATE2 + 1] >> 2) & 0x03;
+	if (ccb_freq_bits != CCB_FREQ_100)
+		return hw_test_fail(ctx, "output %s, expected 100 MHz",
+				    get_ccb_freq_string(ccb_freq_bits));
+
+	return hw_test_pass(ctx, "100 MHz output");
+}
diff --git a/board/mono/gateway_dk/setup/cmd_otpmk.c b/board/mono/gateway_dk/setup/cmd_otpmk.c
new file mode 100644
index 00000000000..0fc487d71d9
--- /dev/null
+++ b/board/mono/gateway_dk/setup/cmd_otpmk.c
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <command.h>
+#include <dm.h>
+#include <fuse.h>
+#include <rng.h>
+#include <vsprintf.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include "security_fuses.h"
+
+/*
+ * Generate a One Time Programmable Master Key and commit it to fuses.
+ *
+ * The key is drawn from CAAM's DRBG and written straight into the fuse mirror
+ * registers, so it is never printed, typed or held anywhere a log could reach.
+ * That is the point of doing this on the board rather than pasting words in
+ * from a host: the OTPMK is what every device-unique secret derives from, and
+ * a value that has been through a terminal is not one.
+ *
+ * The OTPMK mirror registers are write-only: they read back as all ones,
+ * so a load is confirmed through SNVS_HPSR rather than by reading them.
+ *
+ * Mirror words are numbered from the fuse block at SFP + 0x200, so OTPMKR0
+ * (0x1E80234) is word 13 and the eight registers run to word 20. The block
+ * ends with OUIDR4 at 0x284, word 33.
+ */
+#define SFP_NUM_WORDS		34
+#define OTPMK_WORD0		13
+#define OTPMK_NUM_WORDS		8
+#define SRKH_WORD0		21
+#define OSPR0_WORD		0
+
+/*
+ * What 'otpmk gen' left behind for 'otpmk commit': a key loaded and checked
+ * in this session, and the OSPR0 value commit writes back to trigger PROGFB.
+ * Once a PROGFB has been issued the session is over: TA_PROG_SFP may still
+ * be high, and the data sheet allows no fuse block read until it is back at
+ * GND.
+ */
+static bool otpmk_loaded;
+static bool progfb_issued;
+static u32 otpmk_ospr0;
+
+static bool is_otpmk_word(int word)
+{
+	return word >= OTPMK_WORD0 && word < OTPMK_WORD0 + OTPMK_NUM_WORDS;
+}
+
+/*
+ * Read every mirror word except the OTPMK ones, which do not read back and
+ * so say nothing about whether they changed.
+ */
+static int read_mirrors(u32 *words)
+{
+	int word, ret;
+
+	for (word = 0; word < SFP_NUM_WORDS; word++) {
+		if (is_otpmk_word(word)) {
+			words[word] = 0;
+			continue;
+		}
+
+		ret = fuse_sense(0, word, &words[word]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Turn 256 random bits into a valid OTPMK code word, in place. Ported from
+ * TF-A's otpmk_make_code_word_256() so that a key generated here and one
+ * generated by BL2 are encoded identically -- the SFP checks this Hamming
+ * code on every read and reports a mismatch in SVHESR.
+ */
+static void otpmk_make_code_word_256(u8 *otpmk)
+{
+	u8 parity_bit = 0;
+	u8 code_bit = 0;
+	int i;
+
+	for (i = 0; i < 256; i++) {
+		if ((otpmk[i / 8] & (1 << (i % 8))) != 0) {
+			parity_bit ^= 1;
+			code_bit ^= i;
+		}
+	}
+
+	/*
+	 * Inverting otpmk[code_bit] makes the value a valid code word, except
+	 * for overall parity. Above bit 251 two bits are inverted instead,
+	 * which leaves parity untouched.
+	 */
+	if (code_bit < 252) {
+		otpmk[code_bit / 8] ^= (1 << (code_bit % 8));
+		parity_bit ^= 1;
+	} else {
+		otpmk[(code_bit - 4) / 8] ^= (1 << ((code_bit - 4) % 8));
+		otpmk[4 / 8] ^= (1 << (4 % 8));
+	}
+
+	otpmk[0] ^= parity_bit;
+}
+
+/*
+ * The RNG fills the key one 16-byte job at a time. A half that is all zeros
+ * or all ones, or a second half equal to the first, is what a job that
+ * failed without saying so leaves behind; 256 random bits look like that
+ * with probability 2^-126.
+ */
+static bool otpmk_key_plausible(const u32 *key)
+{
+	const u32 *half[2] = { key, key + OTPMK_NUM_WORDS / 2 };
+	int h, i;
+
+	for (h = 0; h < 2; h++) {
+		u32 or = 0, and = ~0U;
+
+		for (i = 0; i < OTPMK_NUM_WORDS / 2; i++) {
+			or |= half[h][i];
+			and &= half[h][i];
+		}
+		if (!or || and == ~0U)
+			return false;
+	}
+
+	return memcmp(half[0], half[1], OTPMK_NUM_WORDS / 2 * sizeof(u32)) != 0;
+}
+
+static bool srkh_blank(const u32 *mirrors)
+{
+	int i;
+
+	for (i = 0; i < SFP_NUM_SRKHR; i++)
+		if (mirrors[SRKH_WORD0 + i])
+			return false;
+
+	return true;
+}
+
+static int otpmk_generate(void)
+{
+	u32 before[SFP_NUM_WORDS], after[SFP_NUM_WORDS];
+	u32 otpmk[OTPMK_NUM_WORDS];
+	u32 hpsr, svhesr, ospr0;
+	struct udevice *dev;
+	int ret, i;
+
+	if (progfb_issued) {
+		printf("otpmk: refusing, a PROGFB was issued in this session; return TA_PROG_SFP\n");
+		printf("otpmk: to GND and power-cycle before doing anything else.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (otpmk_loaded) {
+		printf("otpmk: refusing, a key is already loaded in this session; run 'otpmk commit',\n");
+		printf("otpmk: or power-cycle to start over. A second gen would read the fuse block,\n");
+		printf("otpmk: which is not allowed once TA_PROG_SFP may be above GND.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	/*
+	 * Bring the mirrors in line with the fuses. fuse_read() issues READFB
+	 * only when a mirror has been overridden since the last read, which on
+	 * a fresh boot is never: nothing else writes mirrors (CMD_FUSE is off)
+	 * and a second gen is refused above. So the fuse block is read here
+	 * only after a gen that failed part-way -- before the operator was
+	 * ever told to raise the pin.
+	 */
+	ret = fuse_read(0, OSPR0_WORD, &ospr0);
+	if (ret) {
+		printf("otpmk: reading the fuses failed (err %d)\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	svhesr = in_be32((void *)SFP_SVHESR);
+	hpsr = in_be32((void *)SNVS_HPSR);
+
+	if ((svhesr & (SVHESR_OTPMK_MASK | SVHESR_DRV_MASK)) ||
+	    (hpsr & HPSR_OTPMK_SYNDROME)) {
+		printf("otpmk: refusing, the fuse block reports a Hamming error (SVHESR 0x%08x, HPSR 0x%08x)\n",
+		       svhesr, hpsr);
+		return CMD_RET_FAILURE;
+	}
+
+	if (!(hpsr & HPSR_OTPMK_ZERO)) {
+		printf("otpmk: refusing, OTPMK is already programmed (SNVS_HPSR 0x%08x)\n",
+		       hpsr);
+		printf("otpmk: fuses only go from 0 to 1, so a second key would be OR-ed\n");
+		printf("otpmk: into the first and leave neither usable.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (ospr0 & OSPR_WP) {
+		printf("otpmk: refusing, the fuse block is write-protected (OSPR0 0x%08x)\n",
+		       ospr0);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = read_mirrors(before);
+	if (ret) {
+		printf("otpmk: reading the mirror registers failed (err %d)\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	/*
+	 * PROGFB burns every mirror word along with the key, and a mirror set
+	 * by hand earlier in the session (mw reaches them directly) looks just
+	 * like a fuse. The one such value that destroys the part is ITS with
+	 * no SRK hash: it could never boot again.
+	 */
+	if ((before[OSPR0_WORD] & OSPR_ITS) && srkh_blank(before)) {
+		printf("otpmk: refusing, OSPR0 0x%08x sets ITS with a blank SRK hash; PROGFB would\n",
+		       before[OSPR0_WORD]);
+		printf("otpmk: leave a part that never boots. Power-cycle to reload the mirrors.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	ret = uclass_get_device(UCLASS_RNG, 0, &dev);
+	if (ret) {
+		printf("otpmk: no RNG device (err %d)\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	memset(otpmk, 0, sizeof(otpmk));
+	ret = dm_rng_read(dev, otpmk, sizeof(otpmk));
+	if (ret) {
+		printf("otpmk: RNG read failed (err %d)\n", ret);
+		goto out;
+	}
+
+	if (!otpmk_key_plausible(otpmk)) {
+		printf("otpmk: refusing, the RNG returned a key with a blank or repeated half\n");
+		ret = -EIO;
+		goto out;
+	}
+
+	otpmk_make_code_word_256((u8 *)otpmk);
+
+	/*
+	 * The encoder indexes bits from the low end of the buffer while
+	 * OTPMKR0..7 take the words the other way round, so reverse them --
+	 * TF-A's prog_otpmk() does the same before writing the fuse header.
+	 */
+	for (i = 0; i < OTPMK_NUM_WORDS; i++) {
+		ret = fuse_override(0, OTPMK_WORD0 + i,
+				    otpmk[OTPMK_NUM_WORDS - 1 - i]);
+		if (ret) {
+			printf("otpmk: loading mirror word %d failed (err %d)\n",
+			       OTPMK_WORD0 + i, ret);
+			goto out;
+		}
+	}
+
+	/*
+	 * commit reads nothing once the pin is up, so everything PROGFB
+	 * depends on is checked here, at GND. SNVS follows the mirrors, so
+	 * OTPMK_ZERO clears as soon as a non-zero key is in them and the
+	 * syndrome says whether it is a valid code word; SVHESR must be clear
+	 * altogether, which is what the SFP driver would refuse PROGFB on; and
+	 * loading the key must have moved no other mirror word.
+	 */
+	hpsr = in_be32((void *)SNVS_HPSR);
+	svhesr = in_be32((void *)SFP_SVHESR);
+	if ((hpsr & (HPSR_OTPMK_ZERO | HPSR_OTPMK_SYNDROME)) || svhesr) {
+		printf("otpmk: load FAILED (SNVS_HPSR 0x%08x, SVHESR 0x%08x), do not commit\n",
+		       hpsr, svhesr);
+		ret = -EIO;
+		goto out;
+	}
+
+	ret = read_mirrors(after);
+	if (ret) {
+		printf("otpmk: reading the mirror registers failed (err %d)\n", ret);
+		goto out;
+	}
+	if (memcmp(before, after, sizeof(before))) {
+		printf("otpmk: load FAILED, it changed mirror words besides the key; do not commit\n");
+		ret = -EIO;
+		goto out;
+	}
+
+	otpmk_ospr0 = after[OSPR0_WORD];
+	otpmk_loaded = true;
+	printf("otpmk: key generated and loaded (SNVS_HPSR 0x%08x, SVHESR 0x%08x)\n",
+	       hpsr, svhesr);
+	printf("otpmk: PROGFB also burns the other mirror words; non-zero now:");
+	for (i = 0; i < SFP_NUM_WORDS; i++)
+		if (after[i])
+			printf(" %d=0x%08x", i, after[i]);
+	printf("\n");
+	printf("otpmk: nothing is committed yet, and ANY reset discards it.\n");
+	printf("otpmk: to burn it: apply 1.8 V to TA_PROG_SFP now, then run 'otpmk commit'.\n");
+
+out:
+	memset(otpmk, 0, sizeof(otpmk));
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+/*
+ * LS1046A data sheet, Table 6 note 2: while TA_PROG_SFP is above GND, no
+ * activity but fuse programming -- not even a fuse block read. So commit
+ * reads nothing; gen checked everything with the pin at GND.
+ */
+static int otpmk_commit(void)
+{
+	int ret;
+
+	/* Only ever burn what 'otpmk gen' loaded and checked in this session. */
+	if (!otpmk_loaded) {
+		printf("otpmk: refusing, no key was loaded in this session; run 'otpmk gen' first\n");
+		return CMD_RET_FAILURE;
+	}
+
+	/*
+	 * PROGFB commits every mirror register at once, and the chip allows
+	 * only six such operations for its lifetime. There is no API here to
+	 * fire it without naming a word, so rewrite OSPR0 with the value it
+	 * already holds: fuses only ever go 0 to 1, so writing back what is
+	 * there changes nothing, and the OTPMK mirrors are committed with it.
+	 * The driver allows one PROGFB per boot, and so does this command, so
+	 * whatever happens next, a second attempt needs a power cycle and a
+	 * fresh gen.
+	 */
+	otpmk_loaded = false;
+	progfb_issued = true;
+	printf("otpmk: issuing PROGFB; if this does not return, ground TA_PROG_SFP and power-cycle.\n");
+	ret = fuse_prog(0, OSPR0_WORD, otpmk_ospr0);
+	if (ret) {
+		/* The driver reports a PROGFB that ran and flagged an error the same way. */
+		printf("otpmk: programming failed (err %d), and PROGFB may have run. Return\n", ret);
+		printf("otpmk: TA_PROG_SFP to GND, power-cycle, and read the boot self-test's\n");
+		printf("otpmk: Security fuses line before doing anything else.\n");
+		return CMD_RET_FAILURE;
+	}
+
+	/*
+	 * No readback, for the same reason: the next boot reads the fuses with
+	 * the pin grounded, and its self-test line is the verdict.
+	 */
+	printf("otpmk: PROGFB issued. Return TA_PROG_SFP to GND now, then power-cycle;\n");
+	printf("otpmk: run nothing else first, and do not boot an OS from this session.\n");
+	printf("otpmk: the boot self-test's Security fuses line is the verdict:\n");
+	printf("otpmk:   'OTPMK set'            the key is burned\n");
+	printf("otpmk:   'open, no fuses blown' nothing took -- was TA_PROG_SFP at 1.8 V?\n");
+	printf("otpmk:   'OTPMK damaged'        the burn went wrong; that key is lost\n");
+	printf("otpmk: the secure world uses this key only under secure boot (SecMon trusted).\n");
+
+	return CMD_RET_SUCCESS;
+}
+
+static int do_otpmk(struct cmd_tbl *cmdtp, int flag, int argc,
+		    char *const argv[])
+{
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	if (!strcmp(argv[1], "gen"))
+		return otpmk_generate();
+
+	if (!strcmp(argv[1], "commit"))
+		return otpmk_commit();
+
+	return CMD_RET_USAGE;
+}
+
+U_BOOT_CMD(
+	otpmk, 2, 0, do_otpmk,
+	"One Time Programmable Master Key",
+	"gen - draw 256 bits from the CAAM RNG, Hamming encode them, and\n"
+	"    load the fuse mirror registers. Run it once per boot, with\n"
+	"    TA_PROG_SFP at GND; a second gen in the same session is refused,\n"
+	"    because it would read the fuse block, which the data sheet forbids\n"
+	"    once the pin may be above GND -- power-cycle to start over. Refuses\n"
+	"    if the OTPMK is already programmed, the fuse block is\n"
+	"    write-protected or reports a Hamming error, or the mirrors set ITS\n"
+	"    with a blank SRK hash. Every check commit relies on runs here.\n"
+	"    The key is never printed and cannot be read back; the load is\n"
+	"    confirmed through SNVS_HPSR bit 27 (OTPMK_ZERO) clearing. ANY\n"
+	"    reset discards the mirrors, so gen and commit must run without a\n"
+	"    reset between.\n"
+	"otpmk commit - program the mirror registers into fuses (PERMANENT).\n"
+	"    Apply 1.8 V to TA_PROG_SFP only after gen, then run this. Requires\n"
+	"    a key loaded by 'otpmk gen' in this session, and reads nothing\n"
+	"    itself while the pin is up. Afterwards return the pin to GND and\n"
+	"    power-cycle: the boot self-test's Security fuses line is the\n"
+	"    verdict. Spends one of the six programming cycles the chip allows\n"
+	"    in its lifetime.\n"
+);
diff --git a/board/mono/gateway_dk/setup/ddr_sanity.c b/board/mono/gateway_dk/setup/ddr_sanity.c
new file mode 100644
index 00000000000..586b3c8e1a4
--- /dev/null
+++ b/board/mono/gateway_dk/setup/ddr_sanity.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Quick verification of DDR banks.
+ *
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <cpu_func.h>
+#include <linux/kernel.h>
+#include <asm/global_data.h>
+#include "hw_test.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Probe locations chosen to be safe from u-boot's own RAM usage */
+static const u64 bank0_locations[] = {
+	0x80000000ULL,	/* Start */
+	0xB0000000ULL,	/* ~768MB in */
+	0xF0000000ULL,	/* Near end */
+};
+
+static const u64 bank1_locations[] = {
+	0x880000000ULL,	/* Start */
+	0x900000000ULL,	/* ~2GB in */
+	0x9FFFF0000ULL,	/* Near end */
+};
+
+/*
+ * Round-trip one value through the DDR chip. The dcache is on, so a
+ * plain write+readback would be served entirely from L1; the flush
+ * cleans the written line out to DRAM and invalidates it, forcing
+ * the readback to be a real DRAM fetch.
+ */
+static int probe_value(volatile uint32_t *addr, uint32_t val)
+{
+	*addr = val;
+	flush_dcache_range((unsigned long)addr,
+			   (unsigned long)addr + sizeof(*addr));
+	return *addr != val;
+}
+
+static int probe_bank(const u64 *locations, size_t n, uint32_t pattern)
+{
+	int errors = 0;
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		volatile uint32_t *addr = (volatile uint32_t *)locations[i];
+		uint32_t test_val = pattern ^ (i << 16);
+
+		/* Both polarities, so stuck-at bits fail either way */
+		errors += probe_value(addr, test_val);
+		errors += probe_value(addr, ~test_val);
+	}
+
+	return errors;
+}
+
+int test_ddr_sanity(struct hw_test_ctx *ctx)
+{
+	int errors = 0;
+
+	errors += probe_bank(bank0_locations, ARRAY_SIZE(bank0_locations), 0xDEADBEEF);
+	errors += probe_bank(bank1_locations, ARRAY_SIZE(bank1_locations), 0xCAFEBABE);
+
+	if (errors)
+		return hw_test_fail(ctx, "%d errors", errors);
+
+	return hw_test_pass(ctx, "Bank0: %llu MB, Bank1: %llu MB",
+			    gd->bd->bi_dram[0].size / (1024 * 1024),
+			    gd->bd->bi_dram[1].size / (1024 * 1024));
+}
diff --git a/board/mono/gateway_dk/setup/fan_controller.c b/board/mono/gateway_dk/setup/fan_controller.c
new file mode 100644
index 00000000000..72e83a6e507
--- /dev/null
+++ b/board/mono/gateway_dk/setup/fan_controller.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <linux/delay.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define EMC2302_ADDR		0x2E
+#define I2C_BUS			0
+#define I2C_MUX_CHANNEL		0x08
+#define TACH_HIGH_REG		0x3E
+#define TACH_LOW_REG		0x3F
+
+/* Valid tachometer range. EMC230X_RPM_FACTOR comes from the datasheet
+ * with EMC2305_TACH_CNT_MULTIPLIER = 2.
+ */
+#define EMC230X_RPM_FACTOR	3932160U
+#define TACH_MULTIPLIER		2U
+#define MIN_RPM			1000
+
+static int fan_controller_init(struct udevice *fan_dev)
+{
+	uint8_t reg;
+	int ret;
+
+	/* Invert polarity and set output type to push-pull */
+	reg = 0xff;
+	ret = dm_i2c_write(fan_dev, 0x2a, &reg, 1);
+	if (ret)
+		return ret;
+	ret = dm_i2c_write(fan_dev, 0x2b, &reg, 1);
+	if (ret)
+		return ret;
+
+	/* Set fans to fixed 50% speed; Linux takes over later */
+	reg = 0x80;
+	ret = dm_i2c_write(fan_dev, 0x30, &reg, 1);
+	if (ret)
+		return ret;
+	return dm_i2c_write(fan_dev, 0x40, &reg, 1);
+}
+
+int test_emc2302_fan(struct hw_test_ctx *ctx)
+{
+	struct udevice *fan_dev;
+	uint32_t tach_raw, tach_shifted, base, rpm;
+	int ret;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   I2C_MUX_CHANNEL, EMC2302_ADDR, &fan_dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	if (fan_controller_init(fan_dev))
+		return hw_test_fail(ctx, "Initialization failed");
+
+	/* Give the fan ample amount of time to spin up */
+	mdelay(1000);
+
+	ret = dm_i2c_reg_read(fan_dev, TACH_HIGH_REG);
+	if (ret < 0)
+		return hw_test_fail(ctx, "Failed to read tach high byte");
+	tach_raw = ((uint8_t)ret) << 8;
+
+	ret = dm_i2c_reg_read(fan_dev, TACH_LOW_REG);
+	if (ret < 0)
+		return hw_test_fail(ctx, "Failed to read tach low byte");
+	tach_raw |= (uint8_t)ret;
+
+	if (tach_raw >= 0xFFF0)
+		return hw_test_fail(ctx, "Fan stalled, tach=0x%04x", tach_raw);
+
+	/* Right-shift by 3 bits per datasheet (tach count is left-aligned) */
+	tach_shifted = tach_raw >> 3;
+	if (tach_shifted == 0)
+		return hw_test_fail(ctx, "Tach reading too small, tach=0x%04x", tach_raw);
+
+	base = EMC230X_RPM_FACTOR / tach_shifted;
+	rpm = base * TACH_MULTIPLIER;
+
+	if (rpm < MIN_RPM)
+		return hw_test_fail(ctx, "Fan too slow: %u RPM", rpm);
+
+	return hw_test_pass(ctx, "%u RPM (Fan 1)", rpm);
+}
diff --git a/board/mono/gateway_dk/setup/led_controller.c b/board/mono/gateway_dk/setup/led_controller.c
new file mode 100644
index 00000000000..9637716518c
--- /dev/null
+++ b/board/mono/gateway_dk/setup/led_controller.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ *
+ * The on-board status LED is driven by an LP5810A LED controller.
+ * It is exercised in two phases:
+ *
+ *  - test_lp5810a_led() runs as a normal harness entry: it probes and
+ *    initialises the chip, leaving every status LED off.
+ *  - lp5810a_set_status() is invoked from misc_init_r() AFTER every
+ *    other test has finished, so it can colour the LED according to
+ *    the aggregate result and propagate that result to the kernel.
+ */
+
+#include <config.h>
+#include <stdio.h>
+#include <env.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/kernel.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define LP5810A_ADDR		0x6C
+#define I2C_BUS			2
+#define I2C_MUX_CHANNEL		0x08
+#define CHIP_EN_REG		0x00
+
+/* LED registers */
+#define LED_WHITE_REG		0x40
+#define LED_BLUE_REG		0x41
+#define LED_GREEN_REG		0x42
+#define LED_RED_REG		0x43
+
+#define LED_OFF			0x00
+#define LED_FULL		0xFF
+
+static const uint8_t status_leds[] = {
+	LED_WHITE_REG, LED_BLUE_REG, LED_GREEN_REG, LED_RED_REG,
+};
+
+/* Initial register programming applied during the boot self-test */
+static const struct {
+	uint8_t reg;
+	uint8_t value;
+} init_regs[] = {
+	{ 0x00, 0x01 },	/* CHIP_EN */
+	{ 0x02, 0x00 },	/* DEV_CONFIG_0 */
+	{ 0x10, 0x55 },	/* LED mode config */
+	{ 0x20, 0x0f },	/* LED enable mask */
+	{ 0x30, 0xff },	/* Peak current LED 0 */
+	{ 0x31, 0xff },	/* Peak current LED 1 */
+	{ 0x32, 0xff },	/* Peak current LED 2 */
+	{ 0x33, 0xff },	/* Peak current LED 3 */
+};
+
+static int lp5810a_get_device(struct udevice **dev)
+{
+	return setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				      I2C_MUX_CHANNEL, LP5810A_ADDR, dev);
+}
+
+int test_lp5810a_led(struct hw_test_ctx *ctx)
+{
+	struct udevice *led_dev;
+	uint8_t off = LED_OFF;
+	size_t i;
+
+	if (lp5810a_get_device(&led_dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	if (dm_i2c_reg_read(led_dev, CHIP_EN_REG) < 0)
+		return hw_test_fail(ctx, "CHIP_EN read failed");
+
+	for (i = 0; i < ARRAY_SIZE(init_regs); i++)
+		if (dm_i2c_write(led_dev, init_regs[i].reg, &init_regs[i].value, 1))
+			return hw_test_fail(ctx, "init write to 0x%02x failed",
+					    init_regs[i].reg);
+
+	for (i = 0; i < ARRAY_SIZE(status_leds); i++)
+		if (dm_i2c_write(led_dev, status_leds[i], &off, 1))
+			return hw_test_fail(ctx, "LED off-write to 0x%02x failed",
+					    status_leds[i]);
+
+	return 0;
+}
+
+/*
+ * Light the appropriate status LED and pass the verdict to the kernel
+ * via bootargs_hwtest. Always sets the env var so the kernel can rely
+ * on its presence.
+ */
+void lp5810a_set_status(int any_test_failed)
+{
+	struct udevice *led_dev;
+	uint8_t on = LED_FULL;
+
+	if (lp5810a_get_device(&led_dev))
+		return;
+
+	if (any_test_failed) {
+		dm_i2c_write(led_dev, LED_RED_REG, &on, 1);
+		env_set("bootargs_hwtest", "hwtest_status=fail");
+	} else {
+		dm_i2c_write(led_dev, LED_GREEN_REG, &on, 1);
+		env_set("bootargs_hwtest", "hwtest_status=pass");
+	}
+}
diff --git a/board/mono/gateway_dk/setup/retimer.c b/board/mono/gateway_dk/setup/retimer.c
new file mode 100644
index 00000000000..4b2ed146550
--- /dev/null
+++ b/board/mono/gateway_dk/setup/retimer.c
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define DS100DF410_ADDR		0x18
+#define I2C_BUS			0
+#define I2C_MUX_CHANNEL		0x01
+#define DEVICE_ID_REG		0x01
+#define EXPECTED_DEVICE_ID	0xD0
+
+int test_ds100df410_retimer(struct hw_test_ctx *ctx)
+{
+	struct udevice *dev;
+	int id;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   I2C_MUX_CHANNEL, DS100DF410_ADDR, &dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	id = dm_i2c_reg_read(dev, DEVICE_ID_REG);
+	if (id < 0)
+		return hw_test_fail(ctx, "Read failed");
+
+	if (id != EXPECTED_DEVICE_ID)
+		return hw_test_fail(ctx, "Device ID 0x%02x != 0x%02x",
+				    id, EXPECTED_DEVICE_ID);
+
+	return hw_test_pass(ctx, "ID 0x%02x", id);
+}
diff --git a/board/mono/gateway_dk/setup/rtc.c b/board/mono/gateway_dk/setup/rtc.c
new file mode 100644
index 00000000000..f198cb9cdaf
--- /dev/null
+++ b/board/mono/gateway_dk/setup/rtc.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include <rtc.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define PCF2131_ADDR		0x53
+#define I2C_BUS			2
+#define I2C_MUX_CHANNEL		0x04
+#define CONTROL_2_REG		0x02
+
+/* PWRMNG[2:0] should be set to 000 (battery switch-over enabled) */
+#define PWRMNG_MASK		0xE0
+#define PWRMNG_EXPECTED		0x00
+
+int test_pcf2131_rtc(struct hw_test_ctx *ctx)
+{
+	struct udevice *i2c_dev, *rtc_dev;
+	struct rtc_time tm;
+	uint8_t control_2;
+	int ret;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   I2C_MUX_CHANNEL, PCF2131_ADDR, &i2c_dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	ret = dm_i2c_reg_read(i2c_dev, CONTROL_2_REG);
+	if (ret < 0)
+		return hw_test_fail(ctx, "Failed to read Control_2 register");
+	control_2 = (uint8_t)ret;
+
+	/* Configure PWRMNG if it's not already 000 */
+	if ((control_2 & PWRMNG_MASK) != PWRMNG_EXPECTED) {
+		control_2 &= ~PWRMNG_MASK;
+		if (dm_i2c_reg_write(i2c_dev, CONTROL_2_REG, control_2))
+			return hw_test_fail(ctx, "Failed to configure PWRMNG");
+	}
+
+	/* Find the RTC device by name for dm_rtc_get() */
+	if (uclass_get_device_by_name(UCLASS_RTC, "rtc@53", &rtc_dev))
+		return hw_test_fail(ctx, "RTC device not found");
+
+	if (dm_rtc_get(rtc_dev, &tm))
+		return hw_test_fail(ctx, "Failed to read time");
+
+	return hw_test_pass(ctx, "%04d-%02d-%02d %02d:%02d:%02d",
+			    tm.tm_year, tm.tm_mon, tm.tm_mday,
+			    tm.tm_hour, tm.tm_min, tm.tm_sec);
+}
diff --git a/board/mono/gateway_dk/setup/security_fuses.c b/board/mono/gateway_dk/setup/security_fuses.c
new file mode 100644
index 00000000000..71b331cc26f
--- /dev/null
+++ b/board/mono/gateway_dk/setup/security_fuses.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <asm/io.h>
+#include "hw_test.h"
+#include "security_fuses.h"
+
+static const char *ssm_name(u32 hpsr)
+{
+	switch ((hpsr & HPSR_SSM_ST_MASK) >> HPSR_SSM_ST_SHIFT) {
+	case SSM_ST_CHECK:		return "check";
+	case SSM_ST_NON_SECURE:		return "non-secure";
+	case SSM_ST_TRUSTED:		return "trusted";
+	case SSM_ST_SECURE:		return "secure";
+	case SSM_ST_SOFT_FAIL:		return "soft-fail";
+	default:			return "unknown";
+	}
+}
+
+int test_security_fuses(struct hw_test_ctx *ctx)
+{
+	u32 svhesr, ospr, hpsr;
+	bool otpmk, otpmk_damaged, drv_damaged, srk, its, wp;
+	int i;
+
+	svhesr = in_be32((void *)SFP_SVHESR);
+	hpsr = in_be32((void *)SNVS_HPSR);
+	ospr = in_be32((void *)SFP_OSPR);
+
+	otpmk = !(hpsr & HPSR_OTPMK_ZERO);
+
+	/*
+	 * OTPMK and the debug response value are Hamming protected. The SFP
+	 * reports errors in SVHESR, and SNVS reports the syndrome it computed
+	 * for the OTPMK it holds in HPSR.
+	 */
+	otpmk_damaged = (svhesr & SVHESR_OTPMK_MASK) ||
+			(hpsr & HPSR_OTPMK_SYNDROME);
+	drv_damaged = svhesr & SVHESR_DRV_MASK;
+
+	its = !!(ospr & OSPR_ITS);
+	wp = !!(ospr & OSPR_WP);
+
+	srk = false;
+	for (i = 0; i < SFP_NUM_SRKHR; i++)
+		if (in_be32((void *)SFP_SRKHR(i)))
+			srk = true;
+
+	/*
+	 * Whether a unit is fused is a customer decision, so neither answer
+	 * is a failure. Two combinations cannot have been intended, though:
+	 * ITS commits the part to verified boot, so with no key hash it can
+	 * never boot again, and a key hash without OTPMK is a provisioning
+	 * run that stopped halfway.
+	 */
+	if (its && !srk)
+		return hw_test_fail(ctx, "ITS set with blank SRK hash");
+	if (srk && !otpmk)
+		return hw_test_fail(ctx, "SRK hash set with blank OTPMK");
+
+	/*
+	 * A damaged secret is permanent and nobody can act on it: the unit
+	 * still boots and routes, it just has no usable master key. Say so on
+	 * every boot without failing the run, which would leave the LED red
+	 * for the rest of the unit's life. After an OTPMK burn, this line is
+	 * the verdict.
+	 */
+	if (otpmk_damaged || drv_damaged)
+		return hw_test_warn(ctx, "%s%s%s damaged, SVHESR 0x%08x, HPSR 0x%08x, SecMon %s",
+				    otpmk_damaged ? "OTPMK" : "",
+				    otpmk_damaged && drv_damaged ? " and " : "",
+				    drv_damaged ? "DRV" : "",
+				    svhesr, hpsr, ssm_name(hpsr));
+
+	/*
+	 * The SecMon state says whether the secure world's keys are unique on
+	 * this boot. "OTPMK set, SecMon non-secure" is a burned key that nothing
+	 * uses yet; only a validated boot shows trusted.
+	 */
+	if (!otpmk && !srk && !its && !wp)
+		return hw_test_pass(ctx, "open, no fuses blown, SecMon %s",
+				    ssm_name(hpsr));
+
+	return hw_test_pass(ctx, "OTPMK %s, SRK %s, ITS %s%s, SecMon %s",
+			    otpmk ? "set" : "blank",
+			    srk ? "set" : "blank",
+			    its ? "enforced" : "off",
+			    wp ? ", write-protected" : "",
+			    ssm_name(hpsr));
+}
diff --git a/board/mono/gateway_dk/setup/security_fuses.h b/board/mono/gateway_dk/setup/security_fuses.h
new file mode 100644
index 00000000000..ef0d5862ad4
--- /dev/null
+++ b/board/mono/gateway_dk/setup/security_fuses.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ *
+ * Security Fuse Processor and Secure Non-Volatile Storage registers, shared
+ * by the fuse self-test and the otpmk command.
+ *
+ * Both blocks are big-endian on this SoC, so every access goes through
+ * in_be32(). u-boot's fsl_sfp.h describes the fuse block but is gated on
+ * CONFIG_SYS_FSL_SFP_*, which this board does not select, and it covers
+ * neither SVHESR nor SNVS -- hence the local offsets. They hang off
+ * CFG_SYS_SFP_ADDR, which already points at the fuse register block at
+ * SFP + 0x200.
+ */
+
+#ifndef SECURITY_FUSES_H
+#define SECURITY_FUSES_H
+
+#include <config.h>
+#include <asm/arch/immap_lsch2.h>
+#include <linux/bitops.h>
+#include <linux/types.h>
+
+#define SFP_SVHESR		((ulong)CFG_SYS_SFP_ADDR - 0x200 + 0x024)
+#define SFP_OSPR		((ulong)CFG_SYS_SFP_ADDR)
+#define SFP_SRKHR(n)		((ulong)CFG_SYS_SFP_ADDR + 0x054 + (n) * 4)
+#define SFP_NUM_SRKHR		8
+
+#define SVHESR_DRV_MASK		0x0000007F
+#define SVHESR_OTPMK_MASK	0x0007FC00
+
+#define OSPR_ITS		BIT(2)
+#define OSPR_WP			BIT(0)
+
+/*
+ * SNVS_HPSR. OTPMK_ZERO reads 1 while the key is blank. OTPMK_SYNDROME is
+ * the Hamming syndrome of the key SNVS is holding, zero while it is intact.
+ */
+#define SNVS_HPSR		((ulong)CONFIG_SYS_IMMR + 0xe90014)
+#define HPSR_OTPMK_ZERO		BIT(27)
+#define HPSR_OTPMK_SYNDROME	GENMASK(24, 16)
+
+/*
+ * SecMon state machine. Only a boot the ROM validated against SRKH reaches
+ * trusted or secure, and only there does the SEC use the OTPMK; elsewhere
+ * it uses a public test key, so the secure world's keys are not unique.
+ */
+#define HPSR_SSM_ST_MASK	GENMASK(11, 8)
+#define HPSR_SSM_ST_SHIFT	8
+#define SSM_ST_SOFT_FAIL	0x3
+#define SSM_ST_CHECK		0x9
+#define SSM_ST_NON_SECURE	0xb
+#define SSM_ST_TRUSTED		0xd
+#define SSM_ST_SECURE		0xf
+
+#endif /* SECURITY_FUSES_H */
diff --git a/board/mono/gateway_dk/setup/sfp_i2c_mux.c b/board/mono/gateway_dk/setup/sfp_i2c_mux.c
new file mode 100644
index 00000000000..16bb886ccd1
--- /dev/null
+++ b/board/mono/gateway_dk/setup/sfp_i2c_mux.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SFP I2C Mux Reset/Self-Test
+ *
+ * The SFP channels carry the only field-swappable devices on any i2c
+ * bus. A module caught mid-transfer by a reset keeps driving SDA low --
+ * the cages stay powered across a warm reset, so the module never
+ * reinitialises -- and it does so through a mux channel that is still
+ * selected, which wedges the whole of i2c1 including the mux control
+ * register. Writing 0x00 to that register cannot clear the condition,
+ * because the write needs the very bus the module is holding down.
+ *
+ * RESET# is the way out. Pulsing it disconnects every channel, which
+ * isolates the stuck module and frees the parent bus. The module keeps
+ * holding its own channel until it loses power, so that port stays
+ * unusable, but the mux and the remaining channels come back.
+ *
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <asm/gpio.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define SFP_MUX_ADDR		GATEWAY_DK_I2C_MUX_ADDR
+#define I2C_BUS			1	/* i2c1 - SFP bus */
+#define PCA9545_CTRL_REG	0x00
+
+/* RESET# sits on GPIO3_24, the bank at 0x2320000 (gpio2 in dts numbering). */
+#define SFP_MUX_GPIO_BASE	0x2320000
+#define SFP_MUX_RESET_GPIO	24
+
+/*
+ * Locate the GPIO bank by register address, so the lookup does not depend
+ * on how the driver happens to name its banks.
+ */
+static int sfp_mux_gpio_bank(struct udevice **bankp)
+{
+	struct udevice *dev;
+
+	for (uclass_first_device(UCLASS_GPIO, &dev);
+	     dev;
+	     uclass_next_device(&dev)) {
+		if ((u64)dev_read_addr(dev) == SFP_MUX_GPIO_BASE) {
+			*bankp = dev;
+			return 0;
+		}
+	}
+
+	return -ENODEV;
+}
+
+/*
+ * Pulse RESET# low. The PCA9545 needs 6ns of pulse width and comes back up
+ * with every channel disconnected.
+ */
+static int sfp_mux_pulse_reset(void)
+{
+	struct gpio_desc rst;
+	struct udevice *bank;
+	int ret;
+
+	ret = sfp_mux_gpio_bank(&bank);
+	if (ret)
+		return ret;
+
+	rst.dev = bank;
+	rst.offset = SFP_MUX_RESET_GPIO;
+	rst.flags = 0;
+
+	ret = dm_gpio_request(&rst, "sfp-mux-reset");
+	if (ret)
+		return ret;
+
+	ret = dm_gpio_set_dir_flags(&rst, GPIOD_IS_OUT);
+	if (!ret) {
+		dm_gpio_set_value(&rst, 0);
+		udelay(10);
+		dm_gpio_set_value(&rst, 1);
+		udelay(10);
+	}
+
+	dm_gpio_free(bank, &rst);
+
+	return ret;
+}
+
+int test_sfp_i2c_mux(struct hw_test_ctx *ctx)
+{
+	struct udevice *mux_dev;
+	bool recovered = false;
+	uint8_t ctrl_val;
+	int ret;
+
+	/*
+	 * Reaching the control address doubles as the wedge check:
+	 * i2c_get_chip_for_busnum() puts a real transfer on the bus.
+	 */
+	if (i2c_get_chip_for_busnum(I2C_BUS, SFP_MUX_ADDR, 1, &mux_dev)) {
+		ret = sfp_mux_pulse_reset();
+		if (ret)
+			return hw_test_fail(ctx, "Mux unreachable, RESET# failed (%d)",
+					    ret);
+
+		if (i2c_get_chip_for_busnum(I2C_BUS, SFP_MUX_ADDR, 1, &mux_dev))
+			return hw_test_fail(ctx, "Mux not found on bus %d after RESET#",
+					    I2C_BUS);
+
+		recovered = true;
+	}
+
+	/* Reset mux - disable all channels */
+	ctrl_val = 0x00;
+	if (dm_i2c_write(mux_dev, PCA9545_CTRL_REG, &ctrl_val, 1))
+		return hw_test_fail(ctx, "Reset failed");
+
+	/* Verify reset by reading back */
+	ret = dm_i2c_reg_read(mux_dev, PCA9545_CTRL_REG);
+	if (ret < 0)
+		return hw_test_fail(ctx, "Read-back failed");
+
+	if ((ret & 0x0F) != 0x00)
+		return hw_test_fail(ctx, "Reset verify: expected 0x00, got 0x%02x",
+				    ret & 0x0F);
+
+	if (recovered)
+		return hw_test_pass(ctx, "Reset OK (recovered wedged bus)");
+
+	return hw_test_pass(ctx, "Reset OK");
+}
diff --git a/board/mono/gateway_dk/setup/temp_sensors.c b/board/mono/gateway_dk/setup/temp_sensors.c
new file mode 100644
index 00000000000..5f71717828d
--- /dev/null
+++ b/board/mono/gateway_dk/setup/temp_sensors.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define TMP431_ADDR		0x4C
+#define I2C_BUS			0
+#define CPU_TEMP_CHANNEL	0x02
+#define BOARD_TEMP_CHANNEL	0x04
+#define REMOTE_TEMP_REG		0x01
+#define LOCAL_TEMP_REG		0x00
+
+/*
+ * Sanity limits (degrees Celsius). The test guards against a broken
+ * or misread sensor and against cooling failure, not the operating
+ * envelope: sensor faults read as -55, -64, -128 or +127, so the
+ * floor only needs to sit below anything a working sensor can report
+ * in a home (a cold room, or a unit powered on straight after winter
+ * delivery). The fan curve keeps both sensors well below 60 in every
+ * legitimate state, including a warm reboot, so a reading above it
+ * means the fans or the sensor path are broken.
+ */
+#define TEMP_MIN		0
+#define TEMP_MAX		60
+
+static int read_temperature(struct hw_test_ctx *ctx, const char *label,
+			    uint8_t channel, uint8_t reg, int *temp_out)
+{
+	struct udevice *temp_dev;
+	int ret;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   channel, TMP431_ADDR, &temp_dev))
+		return hw_test_fail(ctx, "%s sensor setup failed", label);
+
+	ret = dm_i2c_reg_read(temp_dev, reg);
+	if (ret < 0)
+		return hw_test_fail(ctx, "%s sensor read failed", label);
+
+	/* Standard-range TMP431 readings are signed two's complement */
+	*temp_out = (int)(int8_t)ret;
+	return 0;
+}
+
+int test_tmp431_temperatures(struct hw_test_ctx *ctx)
+{
+	int cpu_temp, board_temp;
+
+	if (read_temperature(ctx, "CPU", CPU_TEMP_CHANNEL, REMOTE_TEMP_REG, &cpu_temp))
+		return -1;
+
+	if (read_temperature(ctx, "Board", BOARD_TEMP_CHANNEL, LOCAL_TEMP_REG, &board_temp))
+		return -1;
+
+	if (cpu_temp < TEMP_MIN || cpu_temp > TEMP_MAX)
+		return hw_test_fail(ctx, "CPU out of range: %d °C (0x%02x)",
+				    cpu_temp, (uint8_t)cpu_temp);
+
+	if (board_temp < TEMP_MIN || board_temp > TEMP_MAX)
+		return hw_test_fail(ctx, "Board out of range: %d °C (0x%02x)",
+				    board_temp, (uint8_t)board_temp);
+
+	return hw_test_pass(ctx, "CPU %d °C, Board %d °C", cpu_temp, board_temp);
+}
diff --git a/board/mono/gateway_dk/setup/typec_controller.c b/board/mono/gateway_dk/setup/typec_controller.c
new file mode 100644
index 00000000000..cb241c2a814
--- /dev/null
+++ b/board/mono/gateway_dk/setup/typec_controller.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <i2c.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define HD3SS3220_ADDR		0x47
+#define I2C_BUS			2
+#define I2C_MUX_CHANNEL		0x04
+
+/* Expected device ID: "TUSB322" in ASCII, registers 0x00-0x07 read in
+ * reverse order: {0x00, 0x54, 0x55, 0x53, 0x42, 0x33, 0x32, 0x32}.
+ */
+static const uint8_t expected_device_id[8] = {
+	0x32, 0x32, 0x33, 0x42, 0x53, 0x55, 0x54, 0x00
+};
+
+int test_hd3ss3220(struct hw_test_ctx *ctx)
+{
+	struct udevice *hd3ss_dev;
+	uint8_t device_id[8];
+	char ascii[9];
+	int i, j;
+
+	if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+				   I2C_MUX_CHANNEL, HD3SS3220_ADDR, &hd3ss_dev))
+		return hw_test_fail(ctx, "Setup failed");
+
+	if (dm_i2c_read(hd3ss_dev, 0x00, device_id, sizeof(device_id)))
+		return hw_test_fail(ctx, "Failed to read device ID");
+
+	for (i = 0; i < 8; i++)
+		if (device_id[i] != expected_device_id[i])
+			return hw_test_fail(ctx, "Device ID mismatch");
+
+	/* Render device ID in reverse order to show the ASCII string */
+	for (i = 7, j = 0; i >= 0; i--) {
+		if (device_id[i] >= 0x20 && device_id[i] <= 0x7E)
+			ascii[j++] = device_id[i];
+	}
+	ascii[j] = '\0';
+
+	return hw_test_pass(ctx, "%s", ascii);
+}
diff --git a/board/mono/gateway_dk/setup/voltage_sensors.c b/board/mono/gateway_dk/setup/voltage_sensors.c
new file mode 100644
index 00000000000..8bbb6c3983a
--- /dev/null
+++ b/board/mono/gateway_dk/setup/voltage_sensors.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Mono Technologies Inc.
+ *
+ * Voltage rail self-test. Each rail is read via INA234 current sensors
+ * sitting behind a PCA9545 mux on bus 2. Per-rail PASS/FAIL lines are
+ * emitted directly through the harness print helpers (one bracket-
+ * prefixed line each); ctx->printed is set so the harness suppresses
+ * its own summary line for this entry.
+ */
+
+#include <config.h>
+#include <stdio.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/kernel.h>
+#include "i2c_helpers.h"
+#include "hw_test.h"
+
+#define I2C_BUS				2
+#define INA234_BUS_VOLTAGE_REG		0x02
+#define NUM_SENSORS			ARRAY_SIZE(sensors)
+
+typedef struct {
+	uint8_t mux_channel;	/* PCA9545 channel bitmask (e.g. 0x01 = ch0) */
+	uint8_t address;	/* I2C address */
+	uint16_t shunt_mohm;	/* Shunt resistor value in mOhm */
+	uint32_t min_mv;	/* Minimum voltage in mV */
+	uint32_t max_mv;	/* Maximum voltage in mV */
+	const char *rail_name;
+} sensor_config_t;
+
+static const sensor_config_t sensors[] = {
+	/* Channel 0 */
+	{0x01, 0x40, 1, 13365, 22220, "20V Power Rail"},
+	{0x01, 0x41, 1,  4851,  5151, "5V Power Rail"},
+	{0x01, 0x42, 1,   970,  1030, "1V CPU PSU"},
+	{0x01, 0x43, 5,  1158,  1242, "1.2V DDR PSU"},
+	/* Channel 1 */
+	{0x02, 0x40, 5,  1307,  1394, "1.35V SerDes PSU"},
+	{0x02, 0x41, 5,  1732,  1869, "1.8V Power Rail"},
+	{0x02, 0x42, 5,  2396,  2606, "2.5V Power Rail"},
+	{0x02, 0x43, 1,  3188,  3414, "3.3V Power Rail"},
+};
+
+int test_voltage_sensors(struct hw_test_ctx *ctx)
+{
+	int failed = 0;
+	size_t i;
+	char detail[80];
+
+	ctx->printed = 1;	/* we emit per-rail lines ourselves */
+
+	for (i = 0; i < NUM_SENSORS; i++) {
+		const sensor_config_t *sensor = &sensors[i];
+		struct udevice *sensor_dev;
+		uint8_t buf[2];
+		uint16_t raw_voltage, voltage_bits;
+		uint32_t voltage_mv;
+
+		if (setup_i2c_muxed_device(I2C_BUS, GATEWAY_DK_I2C_MUX_ADDR,
+					   sensor->mux_channel, sensor->address, &sensor_dev)) {
+			hw_test_print_fail(sensor->rail_name, "Setup failed");
+			failed = 1;
+			continue;
+		}
+
+		if (dm_i2c_read(sensor_dev, INA234_BUS_VOLTAGE_REG, buf, 2)) {
+			hw_test_print_fail(sensor->rail_name, "Read failed");
+			failed = 1;
+			continue;
+		}
+
+		/* INA234: voltage in bits [14:4], LSB = 25.6 mV.
+		 * Integer math: voltage_mv = (raw >> 4) * 256 / 10.
+		 */
+		raw_voltage = (buf[0] << 8) | buf[1];
+		voltage_bits = raw_voltage >> 4;
+		voltage_mv = (voltage_bits * 256) / 10;
+
+		if (voltage_mv < sensor->min_mv || voltage_mv > sensor->max_mv) {
+			snprintf(detail, sizeof(detail),
+				 "%u.%03u V (limits %u.%03u – %u.%03u V)",
+				 voltage_mv / 1000, voltage_mv % 1000,
+				 sensor->min_mv / 1000, sensor->min_mv % 1000,
+				 sensor->max_mv / 1000, sensor->max_mv % 1000);
+			hw_test_print_fail(sensor->rail_name, detail);
+			failed = 1;
+		} else {
+			snprintf(detail, sizeof(detail), "%u.%03u V",
+				 voltage_mv / 1000, voltage_mv % 1000);
+			hw_test_print_pass(sensor->rail_name, detail);
+		}
+	}
+
+	return failed ? -1 : 0;
+}
-- 
2.47.3

