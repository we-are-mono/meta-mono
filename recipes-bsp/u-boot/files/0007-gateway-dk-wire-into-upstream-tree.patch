From e465a9fae350ff1a1e2eee11ff63466a086111b0 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Sun, 19 Apr 2026 15:25:02 +0200
Subject: [PATCH 7/8] arm, mtd, misc: wire Gateway-DK into the upstream tree

Adds the board to arch/arm/Kconfig and the dts Makefile, and adds the
board's SPI-NOR part to spi-nor-ids.c.

Also makes ls2_sfp probe on a board with no switched programming supply.
device_get_supply_regulator() returns -ENOENT when the phandle property
is simply absent, which the driver did not tolerate alongside -ENODEV and
-ENOSYS, so probe failed and no SFP device bound at all. The supply is
optional everywhere it is used -- both regulator_set_enable() calls are
guarded by if (priv->supply) -- so an absent one should not be fatal.

This board deliberately has no such regulator: POVDD stays a bare test
point so that software cannot raise the fuse programming voltage, since
anything able to do so could set ITS on a unit with a blank SRK hash and
brick it permanently with no recovery. Any Layerscape board making that
same choice hits this.

That hunk is upstreamable on its own and is only carried here to keep the
series at eight patches; it is not product-specific like the rest.

Upstream-Status: Inappropriate [product-specific]

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 arch/arm/Kconfig              | 17 +++++++++++++++++
 arch/arm/dts/Makefile         |  2 ++
 drivers/misc/ls2_sfp.c        |  2 +-
 drivers/mtd/spi/spi-nor-ids.c |  3 +++
 4 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
index 7d6d3394797..489169afbca 100644
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -1918,6 +1918,22 @@ config TARGET_LS1046AFRWY
 	  development platform that supports the QorIQ LS1046A
 	  Layerscape Architecture processor.
 
+config TARGET_GATEWAY_DK
+	bool "Support gateway_dk"
+	select ARCH_LS1046A
+	select ARM64
+	select ARMV8_MULTIENTRY
+	select ARCH_SUPPORT_TFABOOT
+	select BOARD_EARLY_INIT_F
+	select BOARD_LATE_INIT
+	select DM_SPI_FLASH if DM_SPI
+	select GPIO_EXTRA_HEADER
+	help
+	  Support for Gateway Development Kit.
+	  Gateway Development Kit is a high-performance
+	  development platform that is based on the QorIQ LS1046A
+	  Layerscape Architecture processor.
+
 config ARCH_SC5XX
 	bool "Analog Devices SC5XX-processor family"
 	select ADI_SC5XX_TIMER
@@ -2446,6 +2462,7 @@ source "board/hisilicon/hikey960/Kconfig"
 source "board/hisilicon/poplar/Kconfig"
 source "board/isee/igep003x/Kconfig"
 source "board/kontron/sl28/Kconfig"
+source "board/mono/gateway_dk/Kconfig"
 source "board/myir/mys_6ulx/Kconfig"
 source "board/samsung/common/Kconfig"
 source "board/siemens/common/Kconfig"
diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 947e1b24514..c2292695012 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -537,6 +537,8 @@ dtb-$(CONFIG_TARGET_SL28) += fsl-ls1028a-kontron-sl28.dtb \
 
 dtb-$(CONFIG_TARGET_TEN64) += fsl-ls1088a-ten64.dtb
 
+dtb-$(CONFIG_TARGET_GATEWAY_DK) += mono-gateway-dk.dtb
+
 dtb-$(CONFIG_TARGET_STEMMY) += ste-ux500-samsung-stemmy.dtb
 
 dtb-$(CONFIG_MACH_SUN4I) += \
diff --git a/drivers/misc/ls2_sfp.c b/drivers/misc/ls2_sfp.c
index 8cb6e999bed..7e3b388ed01 100644
--- a/drivers/misc/ls2_sfp.c
+++ b/drivers/misc/ls2_sfp.c
@@ -229,7 +229,7 @@ static int ls2_sfp_probe(struct udevice *dev)
 	}
 
 	ret = device_get_supply_regulator(dev, "ta-sfp-prog-supply", &priv->supply);
-	if (ret && ret != -ENODEV && ret != -ENOSYS) {
+	if (ret && ret != -ENODEV && ret != -ENOSYS && ret != -ENOENT) {
 		dev_dbg(dev, "problem getting supply (err %d)\n", ret);
 		return ret;
 	}
diff --git a/drivers/mtd/spi/spi-nor-ids.c b/drivers/mtd/spi/spi-nor-ids.c
index a9f1b5faf2c..ddaf4568712 100644
--- a/drivers/mtd/spi/spi-nor-ids.c
+++ b/drivers/mtd/spi/spi-nor-ids.c
@@ -355,6 +355,9 @@ const struct flash_info spi_nor_ids[] = {
 	{ INFO6("mt25qu512a",  0x20bb20, 0x104400, 64 * 1024, 1024,
 		 SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ | SPI_NOR_4B_OPCODES |
 		 USE_FSR) },
+	{ INFO6("mt25qu512abb",  0x20bb20, 0x104000, 64 * 1024, 1024,
+		 SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ | SPI_NOR_4B_OPCODES |
+		 USE_FSR) },
 	{ INFO("n25q512a",    0x20bb20, 0, 64 * 1024, 1024, SECT_4K | USE_FSR | SPI_NOR_QUAD_READ) },
 	{ INFO6("mt25ql512a",  0x20ba20, 0x104400, 64 * 1024, 1024, SECT_4K | USE_FSR | SPI_NOR_QUAD_READ | SPI_NOR_4B_OPCODES) },
 	{ INFO("n25q512ax3",  0x20ba20, 0, 64 * 1024, 1024, SECT_4K | USE_FSR | SPI_NOR_QUAD_READ) },
