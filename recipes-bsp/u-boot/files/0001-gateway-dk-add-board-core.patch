+
+#include "../common/i2c_mux.h"
+#include "setup/hw_test.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int test_sfp_i2c_mux(struct hw_test_ctx *ctx);
+int test_ddr_sanity(struct hw_test_ctx *ctx);
+int test_voltage_sensors(struct hw_test_ctx *ctx);
+int test_stusb4500_nvm(struct hw_test_ctx *ctx);
+int test_hd3ss3220(struct hw_test_ctx *ctx);
+int test_pcf2131_rtc(struct hw_test_ctx *ctx);
+int test_eeprom(struct hw_test_ctx *ctx);
+int test_ds100df410_retimer(struct hw_test_ctx *ctx);
+int test_6v49205b_clkgen(struct hw_test_ctx *ctx);
+int test_emc2302_fan(struct hw_test_ctx *ctx);
+int test_tmp431_temperatures(struct hw_test_ctx *ctx);
+int test_lp5810a_led(struct hw_test_ctx *ctx);
+void lp5810a_set_status(int any_test_failed);
+
+/*
+ * Pin-mux workaround for erratum A-010539, mirroring upstream
+ * erratum_a010539() in arch/arm/cpu/armv8/fsl-layerscape/soc.c: the
+ * RCW source field in PORSR1 drives the muxing of pins shared with
+ * the boot interface, which leaves I2C2 unavailable after SDHC/eMMC
+ * boot. Clearing RCW_SRC through the DCSR-mapped PORCR1 releases the
+ * pins. The upstream copy is only built for CONFIG_QSPI_BOOT, which
+ * TFABOOT does not define, and this board needs the workaround for
+ * eMMC boot as well, so it is carried here for both boot media.
+ */
+
+#define DCFG_PORSR1_OFFSET		0x000
+#define ERRATUM_A010539_TRIGGER_OFFSET	0x1A8
+
+static void erratum_a010539(void)
+{
+	u32 porsr1_val;
+
+	porsr1_val = in_be32((void *)(CFG_SYS_FSL_GUTS_ADDR + DCFG_PORSR1_OFFSET));
+	porsr1_val &= ~RCW_SRC_MASK;
+	out_be32((void *)CFG_SYS_DCSR_DCFG_ADDR, porsr1_val);
+	out_be32((void *)(CFG_SYS_FSL_SCFG_ADDR + ERRATUM_A010539_TRIGGER_OFFSET), 0xFFFFFFFF);
+}
+
+int board_early_init_f(void)
+{
+	erratum_a010539();
+
+	fsl_lsch2_early_init_f();
+
+	return 0;
+}
+
+int checkboard(void)
+{
+	return 0;
+}
+
+int board_setup_core_volt(u32 vdd)
+{
+	return 0;
+}
+
+#ifdef CONFIG_MISC_INIT_R
+static const struct hw_test hw_tests[] = {
+	{ "SFP I2C mux",       test_sfp_i2c_mux },
+	{ "DDR4 Memory",       test_ddr_sanity },
+	{ "USB PD controller", test_stusb4500_nvm },
+	{ "Voltage Rails",     test_voltage_sensors },
+	{ "Temperatures",      test_tmp431_temperatures },
+	{ "USB Type-C ctrl.",  test_hd3ss3220 },
+	{ "RTC",               test_pcf2131_rtc },
+	{ "EEPROM",            test_eeprom },
+	{ "Retimer",           test_ds100df410_retimer },
+	{ "Clock generator",   test_6v49205b_clkgen },
+	{ "Fan controller",    test_emc2302_fan },
+	{ "LED controller",    test_lp5810a_led },
+};
+
+int misc_init_r(void)
+{
+	struct hw_test_result r;
+
+	hw_tests_print_banner("Boot Self-Test");
+	r = hw_tests_run(hw_tests, ARRAY_SIZE(hw_tests));
+
+	/* Surface the aggregate result on the front-panel LED and propagate
+	 * it to the kernel via bootargs.
+	 */
+	lp5810a_set_status(r.failed > 0 ? -1 : 0);
+
+	hw_tests_print_summary(r);
+
+	return 0;
+}
+#endif
+
+int fsl_board_late_init(void)
+{
+	return 0;
+}
+
+int board_init(void)
+{
+
+#ifdef CONFIG_NXP_ESBC
+	/*
+	 * In case of Secure Boot, the IBR configures the SMMU
+	 * to allow only Secure transactions.
+	 * SMMU must be reset in bypass mode.
+	 * Set the ClientPD bit and Clear the USFCFG Bit
+	 */
+	u32 val;
+	val = (in_le32(SMMU_SCR0) | SCR0_CLIENTPD_MASK) & ~(SCR0_USFCFG_MASK);
+	out_le32(SMMU_SCR0, val);
+	val = (in_le32(SMMU_NSCR0) | SCR0_CLIENTPD_MASK) & ~(SCR0_USFCFG_MASK);
+	out_le32(SMMU_NSCR0, val);
+#endif
+
+	return 0;
+}
+
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	u64 base[CONFIG_NR_DRAM_BANKS];
+	u64 size[CONFIG_NR_DRAM_BANKS];
+
+	/* fixup DT for the two DDR banks */
+	base[0] = gd->bd->bi_dram[0].start;
+	size[0] = gd->bd->bi_dram[0].size;
+
+	base[1] = gd->bd->bi_dram[1].start;
+	size[1] = gd->bd->bi_dram[1].size;
+
+	fdt_fixup_memory_banks(blob, base, size, 2);
+	ft_cpu_setup(blob, bd);
+
+#ifdef CONFIG_SYS_DPAA_FMAN
+#ifndef CONFIG_DM_ETH
+	fdt_fixup_fman_ethernet(blob);
+#endif
+#endif
+
+	fdt_fixup_icid(blob);
+	return 0;
+}
