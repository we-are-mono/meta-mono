#!/bin/bash
#
# firmware - Firmware management utility for Mono Gateway Development Kit
#

set -euo pipefail

FIRMWARE_URL="https://firmware.mono.si"
PUBKEY="/etc/firmware/firmware-signing.pub"
DOWNLOAD_DIR=""  # set to a private mktemp dir in cmd_update
ENV_SIZE=8192  # 0x2000 bytes
ENV_OFFSET=3145728  # 0x300000

# eMMC device
EMMC_DEV="/dev/mmcblk0"

# Terminal colors for emphasis on the recovery console
RED=$'\e[1;31m'
GREEN=$'\e[1;32m'
GRAY=$'\e[38;2;150;150;150m'
RESET=$'\e[0m'
CHECK="${GREEN}✓${RESET}"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

# Find MTD device node by partition label (e.g. "rcw-bl2" -> "/dev/mtd0")
find_mtd() {
    local label="$1"
    local sysdir
    for sysdir in /sys/class/mtd/mtd[0-9]*/; do
        if [ -f "${sysdir}name" ] && [ "$(cat "${sysdir}name")" = "$label" ]; then
            echo "/dev/$(basename "$sysdir")"
            return 0
        fi
    done
    die "MTD partition '$label' not found"
}

info() {
    echo ":: $*"
}

# Detect boot medium from kernel command line (set by U-Boot)
detect_boot_medium() {
    local cmdline
    cmdline=$(cat /proc/cmdline)
    if [[ "$cmdline" =~ boot_medium=([a-z]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        die "Cannot detect boot medium. U-Boot must pass boot_medium= on kernel command line."
    fi
}

# Return the opposite medium
target_medium() {
    case "$1" in
        qspi) echo "emmc" ;;
        emmc) echo "qspi" ;;
        *) die "Unknown boot medium: $1" ;;
    esac
}

# Auto-detect MAC address from the first ethernet interface with one assigned
detect_mac() {
    local mac
    mac=$(ip -o link show | grep -m1 'ether' | sed 's|.*ether \([^ ]*\).*|\1|')
    if [ -z "$mac" ]; then
        die "Could not auto-detect MAC address. Ensure a network interface is available."
    fi
    echo "$mac"
}

# Check that networking is functional. Accept either an IPv4 or IPv6 default
# route — many deployments are IPv6-only (SLAAC) and curl can reach
# firmware.mono.si over either family.
check_network() {
    local v4 v6
    v4=$(ip -4 route show default 2>/dev/null)
    v6=$(ip -6 route show default 2>/dev/null)
    if [ -z "$v4" ] && [ -z "$v6" ]; then
        die "No default route configured. Set up networking first:
  ip link set <iface> up
  ip addr add <ip>/<mask> dev <iface>           # for IPv4
  ip route add default via <gateway> dev <iface>
or rely on IPv6 SLAAC autoconfiguration."
    fi
}

# Clean up on exit
cleanup() {
    [ -n "$DOWNLOAD_DIR" ] && rm -rf "$DOWNLOAD_DIR"
}

# Fetch firmware + signature from the network using MAC-as-password basic auth.
# Writes ${DOWNLOAD_DIR}/${fw_file} and ${DOWNLOAD_DIR}/${sig_file}.
fetch_via_network() {
    local fw_file="$1" sig_file="$2"

    check_network

    local mac
    mac=$(detect_mac)
    info "Using MAC address: $mac"

    info "Downloading firmware image..."
    curl -fS -u "mono:${mac}" -o "${DOWNLOAD_DIR}/${fw_file}" "${FIRMWARE_URL}/${fw_file}" || \
        die "Failed to download firmware image"

    info "Downloading signature..."
    curl -fS -u "mono:${mac}" -o "${DOWNLOAD_DIR}/${sig_file}" "${FIRMWARE_URL}/${sig_file}" || \
        die "Failed to download signature"
}

# Copy firmware + signature from a local directory.
fetch_via_local() {
    local src_dir="$1" fw_file="$2" sig_file="$3"

    [ -d "$src_dir" ] || die "Source directory not found: $src_dir"
    [ -f "${src_dir}/${fw_file}" ] || die "Firmware image not found: ${src_dir}/${fw_file}"
    [ -f "${src_dir}/${sig_file}" ] || die "Signature not found: ${src_dir}/${sig_file} (must sit next to the .bin)"

    info "Using firmware from: $src_dir"
    cp "${src_dir}/${fw_file}" "${DOWNLOAD_DIR}/${fw_file}" || die "Failed to copy firmware"
    cp "${src_dir}/${sig_file}" "${DOWNLOAD_DIR}/${sig_file}" || die "Failed to copy signature"
}

# Find a USB partition that contains the requested firmware files, mount it
# read-only, copy the files into ${DOWNLOAD_DIR}, then unmount.
# Refuses to proceed if the files are found on multiple partitions.
fetch_via_usb() {
    local fw_file="$1" sig_file="$2"
    local mountpoint="/tmp/firmware-update-usb"
    local matches=""
    local partial=""   # locations where .bin exists but .sig doesn't (or vice versa)
    local part fstype rel rels

    info "Scanning USB drives for ${fw_file}..."

    # Get list of USB partitions with a usable filesystem.
    # lsblk -P gives KEY=VAL pairs; safe to eval-parse without word-splitting issues.
    local usb_parts
    usb_parts=$(lsblk -P -o NAME,TYPE,TRAN,FSTYPE 2>/dev/null) || \
        die "lsblk failed (recovery image may be missing util-linux-lsblk)"

    # Walk the device tree: find disks where TRAN=usb, then list their partitions.
    local usb_disks
    usb_disks=$(echo "$usb_parts" | awk -F'"' '/TYPE="disk".*TRAN="usb"/ {for(i=1;i<=NF;i++) if($i ~ /NAME=/) print $(i+1)}')
    [ -n "$usb_disks" ] || die "No USB drives found. Plug in a USB stick (FAT32, exFAT, or ext4) containing ${fw_file} and ${sig_file}."

    mkdir -p "$mountpoint"

    # Ensure we always unmount on exit, even on failure
    local _prev_trap
    _prev_trap=$(trap -p EXIT | sed -e "s/^trap -- '//" -e "s/' EXIT$//")
    trap "umount '$mountpoint' 2>/dev/null; ${_prev_trap}" EXIT

    for disk in $usb_disks; do
        # Enumerate partitions of this disk; if no partitions, the whole disk may be a fs.
        local candidates
        candidates=$(echo "$usb_parts" | awk -F'"' -v d="$disk" '
            /TYPE="part"/ {
                name=""; fstype=""
                for(i=1;i<=NF;i++) {
                    if($i ~ /NAME=/) name=$(i+1)
                    if($i ~ /FSTYPE=/) fstype=$(i+1)
                }
                if (index(name, d) == 1 && fstype != "") print name
            }')
        # Fall back to whole-disk if no partitions matched
        if [ -z "$candidates" ]; then
            local disk_fs
            disk_fs=$(echo "$usb_parts" | awk -F'"' -v d="$disk" '
                /TYPE="disk"/ {
                    name=""; fstype=""
                    for(i=1;i<=NF;i++) {
                        if($i ~ /NAME=/) name=$(i+1)
                        if($i ~ /FSTYPE=/) fstype=$(i+1)
                    }
                    if (name == d && fstype != "") print name
                }')
            candidates="$disk_fs"
        fi

        for part in $candidates; do
            info "Checking /dev/${part}..."
            if ! mount -o ro "/dev/${part}" "$mountpoint" 2>/dev/null; then
                info "  could not mount /dev/${part}, skipping"
                continue
            fi

            # Look for the file pair in known locations.
            # Track .bin-only and .sig-only locations separately so we can
            # give a useful error if the user forgot one of the two files.
            #
            # seen_inodes guards against case-insensitive filesystems (exFAT,
            # FAT32) where "firmware/", "Firmware/", and "FIRMWARE/" all
            # resolve to the same physical directory. We record the inode of
            # each matched directory and skip it if already seen, so only one
            # match is recorded regardless of which spelling was probed first.
            local seen_inodes=""
            for rel in "" "firmware/" "Firmware/" "FIRMWARE/"; do
                local has_bin=0 has_sig=0
                [ -f "${mountpoint}/${rel}${fw_file}" ] && has_bin=1
                [ -f "${mountpoint}/${rel}${sig_file}" ] && has_sig=1
                if [ "$has_bin" = 1 ] && [ "$has_sig" = 1 ]; then
                    local inode
                    inode=$(stat -c '%i' "${mountpoint}/${rel:-.}" 2>/dev/null) || true
                    if [ -n "$inode" ] && echo "$seen_inodes" | grep -qF "|${inode}|"; then
                        continue
                    fi
                    seen_inodes="${seen_inodes}|${inode}|"
                    matches="${matches}/dev/${part}:${rel}
"
                elif [ "$has_bin" = 1 ]; then
                    partial="${partial}/dev/${part}:/${rel}${fw_file} (missing ${sig_file})
"
                elif [ "$has_sig" = 1 ]; then
                    partial="${partial}/dev/${part}:/${rel}${sig_file} (missing ${fw_file})
"
                fi
            done

            umount "$mountpoint" 2>/dev/null || true
        done
    done

    # Trim trailing newline and count matches
    matches=$(echo "$matches" | sed '/^$/d')
    local n_matches
    n_matches=$(echo "$matches" | grep -c . || true)

    if [ "$n_matches" -eq 0 ]; then
        partial=$(echo "$partial" | sed '/^$/d')
        if [ -n "$partial" ]; then
            echo "ERROR: Found incomplete firmware on USB:" >&2
            echo "$partial" | sed 's/^/  /' >&2
            die "Both ${fw_file} and ${sig_file} must be in the same directory."
        fi
        die "No matching firmware found on any USB drive. Expected ${fw_file} and ${sig_file} at the root or in a 'firmware/' folder."
    fi
    if [ "$n_matches" -gt 1 ]; then
        echo "ERROR: Multiple matching firmware images found:" >&2
        echo "$matches" | sed 's/^/  /' >&2
        die "Refusing to choose. Remove duplicates so exactly one location matches."
    fi

    # Exactly one match: parse "device:reldir" and copy
    local match_dev match_rel
    match_dev=$(echo "$matches" | cut -d: -f1)
    match_rel=$(echo "$matches" | cut -d: -f2-)

    info "Mounting $match_dev (read-only)..."
    mount -o ro "$match_dev" "$mountpoint" || die "Failed to mount $match_dev"

    info "Copying firmware from ${match_dev}:/${match_rel}..."
    cp "${mountpoint}/${match_rel}${fw_file}" "${DOWNLOAD_DIR}/${fw_file}" || die "Failed to copy firmware"
    cp "${mountpoint}/${match_rel}${sig_file}" "${DOWNLOAD_DIR}/${sig_file}" || die "Failed to copy signature"

    umount "$mountpoint" 2>/dev/null || true
}

cmd_update() {
    local boot_medium target source="net" from_path="" preserve_env=0 custom_url=""

    # Parse args
    while [ $# -gt 0 ]; do
        case "$1" in
            --usb) source="usb"; shift ;;
            --from) source="local"; from_path="${2:-}"; shift 2 ;;
            --from=*) source="local"; from_path="${1#--from=}"; shift ;;
            --url) custom_url="${2:-}"; shift 2 ;;
            --url=*) custom_url="${1#--url=}"; shift ;;
            --preserve-env) preserve_env=1; shift ;;
            -h|--help)
                cmd_help
                exit 0
                ;;
            *) die "Unknown option: $1. Run 'firmware help' for usage." ;;
        esac
    done

    if [ -n "$custom_url" ]; then
        # Strip a trailing slash so we don't end up with a double slash in URLs
        custom_url="${custom_url%/}"
        # --url only makes sense for the network source
        if [ "$source" != "net" ]; then
            die "--url cannot be combined with --usb or --from"
        fi
        # Dynamic scope: shadow the global FIRMWARE_URL for the rest of this
        # function and anything it calls (fetch_via_network).
        local FIRMWARE_URL="$custom_url"
    fi

    if [ "$source" = "local" ] && [ -z "$from_path" ]; then
        die "--from requires a path (a directory containing the .bin and .sig)"
    fi

    boot_medium=$(detect_boot_medium)
    target=$(target_medium "$boot_medium")

    local env_label="no"
    [ "$preserve_env" = 1 ] && env_label="yes"

    # Show "net" or "net (custom URL)" so it's obvious when an override is in play
    local source_label="$source"
    if [ "$source" = "net" ] && [ -n "$custom_url" ]; then
        source_label="net ($custom_url)"
    fi

    echo ""
    echo "╔═════════════════════════════════════════════════════════╗"
    echo "║                    FIRMWARE UPDATE                      ║"
    echo "╠═════════════════════════════════════════════════════════╣"
    printf "║  Booted from:   ${GRAY}%-39s${RESET} ║\n" "$boot_medium"
    printf "║  Target:        ${GRAY}%-39s${RESET} ║\n" "$target"
    printf "║  Source:        ${GRAY}%-39s${RESET} ║\n" "$source_label"
    printf "║  Preserve env:  ${GRAY}%-39s${RESET} ║\n" "$env_label"
    echo "║                                                         ║"
    echo "║  DO NOT power off or interrupt the device during the    ║"
    echo "║  update. Doing so may result in an unrecoverable state  ║"
    echo "║  requiring a hardware programmer to fix.                ║"
    echo "║                                                         ║"
    echo "║  For full documentation, visit: https://docs.mono.si/   ║"
    echo "╚═════════════════════════════════════════════════════════╝"
    if [ "$preserve_env" = 0 ]; then
        echo ""
        echo "!! U-boot environment WILL NOT be preserved. Saved boot settings,"
        echo "!! custom env vars, and boot counters will reset to defaults."
        echo "!! Pass --preserve-env to keep them."
    fi
    echo ""
    read -rp "Type 'yes' to proceed: " confirm
    if [ "$confirm" != "yes" ]; then
        echo "Aborted."
        exit 0
    fi

    # Stage the firmware bytes via the chosen transport in a private temp
    # dir (mktemp, not a fixed world-known path) so the verified image can't
    # be swapped between the signature check and the flash write.
    DOWNLOAD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/firmware-update.XXXXXX") || die "Failed to create temp staging dir"
    trap cleanup EXIT
    local fw_file="firmware-${target}-@MACHINE@.bin"
    local sig_file="firmware-${target}-@MACHINE@.bin.sig"

    case "$source" in
        net)   fetch_via_network "$fw_file" "$sig_file" ;;
        usb)   fetch_via_usb     "$fw_file" "$sig_file" ;;
        local) fetch_via_local   "$from_path" "$fw_file" "$sig_file" ;;
    esac

    # Verify signature
    if [ -f "$PUBKEY" ]; then
        info "Verifying firmware signature..."
        if ! openssl dgst -sha256 -verify "$PUBKEY" \
                -signature "${DOWNLOAD_DIR}/${sig_file}" \
                "${DOWNLOAD_DIR}/${fw_file}" >/dev/null 2>&1; then
            die "Signature verification FAILED. The firmware image may be corrupted or tampered with."
        fi
        info "Signature verified ${CHECK}"
    else
        die "Public key not found at $PUBKEY. Cannot verify firmware integrity."
    fi

    # Back up U-Boot environment from the target medium (only if preserving)
    if [ "$preserve_env" = 1 ]; then
        info "Backing up U-Boot environment from ${target}..."
        if [ "$target" = "qspi" ]; then
            local mtd_env
            mtd_env=$(find_mtd "uboot-env")
            dd if="$mtd_env" of="${DOWNLOAD_DIR}/uboot-env.bin" bs=$ENV_SIZE count=1 2>/dev/null || \
                die "Failed to back up U-Boot environment from $mtd_env"
        else
            dd if="$EMMC_DEV" of="${DOWNLOAD_DIR}/uboot-env.bin" bs=1 skip=$ENV_OFFSET count=$ENV_SIZE 2>/dev/null || \
                die "Failed to back up U-Boot environment from $EMMC_DEV"
        fi
        info "Environment backed up ${CHECK}"
    fi

    # Flash firmware
    info "Flashing firmware to ${target} (${RED}DO NOT INTERRUPT${RESET})..."
    if [ "$target" = "qspi" ]; then
        local mtd_flash
        mtd_flash=$(find_mtd "flash")
        flashcp -v "${DOWNLOAD_DIR}/${fw_file}" "$mtd_flash" || \
            die "Flash failed!"
    else
        dd if="${DOWNLOAD_DIR}/${fw_file}" of="$EMMC_DEV" bs=4096 skip=1 seek=1 || \
            die "Flash failed!"
        sync
    fi
    info "Firmware flashed ${CHECK}"

    # Restore U-Boot environment (only if we backed it up)
    if [ "$preserve_env" = 1 ]; then
        info "Restoring U-Boot environment..."
        if [ "$target" = "qspi" ]; then
            local mtd_env
            mtd_env=$(find_mtd "uboot-env")
            flashcp "${DOWNLOAD_DIR}/uboot-env.bin" "$mtd_env" || \
                die "Failed to restore U-Boot environment"
        else
            dd if="${DOWNLOAD_DIR}/uboot-env.bin" of="$EMMC_DEV" bs=1 seek=$ENV_OFFSET || \
                die "Failed to restore U-Boot environment"
            sync
        fi
        info "Environment restored ${CHECK}"
    else
        info "Skipped u-boot environment restore (--preserve-env not set)"
    fi

    echo ""
    info "Firmware update complete. Reboot to use the new firmware."
}

cmd_backup() {
    local boot_medium target

    boot_medium=$(detect_boot_medium)
    target=$(target_medium "$boot_medium")

    local backup_file="/tmp/firmware-${target}-backup.bin"

    info "Booted from ${boot_medium}, backing up ${target} firmware..."
    if [ "$target" = "qspi" ]; then
        local mtd_flash
        mtd_flash=$(find_mtd "flash")
        dd if="$mtd_flash" of="$backup_file" 2>/dev/null || \
            die "Failed to read from $mtd_flash"
    else
        dd if="$EMMC_DEV" of="$backup_file" bs=1M count=32 2>/dev/null || \
            die "Failed to read from $EMMC_DEV"
    fi

    local size
    size=$(stat -c%s "$backup_file")
    info "Backup saved to $backup_file ($((size / 1024 / 1024)) MB)"
}

cmd_version() {
    local version="unknown"
    if [ -f /etc/firmware/version ]; then
        version=$(cat /etc/firmware/version)
    fi
    echo "Mono Gateway Firmware v${version}"
}

cmd_help() {
    echo "Usage: firmware <command> [options]"
    echo ""
    echo "Commands:"
    echo "  update [opts]   Verify and flash firmware to the inactive medium"
    echo "  backup          Back up the inactive medium's firmware to /tmp"
    echo "  version         Show firmware version"
    echo "  help            Show this help message"
    echo ""
    echo "update options — source (pick one):"
    echo "  (none)          Download from ${FIRMWARE_URL} (requires network)"
    echo "  --url URL       Download from URL instead of the default server"
    echo "                  (useful for a local dev server; only with the"
    echo "                  network source — not compatible with --usb/--from)"
    echo "  --usb           Find firmware on a plugged-in USB drive"
    echo "  --from PATH     Use a local directory containing the .bin and .sig"
    echo ""
    echo "update options — u-boot environment:"
    echo "  (default)       Full rewrite: u-boot env resets to firmware defaults"
    echo "  --preserve-env  Back up the current u-boot env before flashing and"
    echo "                  restore it after (keeps saved boot settings, custom"
    echo "                  env vars, boot counters)"
    echo ""
    echo "The tool auto-detects which medium the device booted from and"
    echo "always targets the other one (qspi <-> emmc)."
    echo ""
    echo "USB drive layout: place the firmware files at the drive root or in a"
    echo "  'firmware/' folder. Filenames must match exactly:"
    echo "    firmware-<target>-@MACHINE@.bin"
    echo "    firmware-<target>-@MACHINE@.bin.sig"
    echo "  where <target> is the medium being written (the opposite of the"
    echo "  one you booted from). FAT32, exFAT, and ext4 sticks all work."
    echo ""
    echo "Examples:"
    echo "  firmware update                        Update over network (env wiped)"
    echo "  firmware update --usb                  Update from USB drive"
    echo "  firmware update --from /mnt/usb        Update from a mounted dir"
    echo "  firmware update --url http://10.0.0.5  Download from a dev server"
    echo "  firmware update --usb --preserve-env   Update from USB, keep env"
    echo "  firmware backup                        Back up the inactive medium"
    echo ""
    echo "Documentation: https://docs.mono.si/"
}

# Main dispatch
case "${1:-help}" in
    update)  shift; cmd_update "$@" ;;
    backup)  shift; cmd_backup "$@" ;;
    version) cmd_version ;;
    help|--help|-h) cmd_help ;;
    *) die "Unknown command: $1. Run 'firmware help' for usage." ;;
esac
