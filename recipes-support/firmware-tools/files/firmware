#!/bin/bash
#
# firmware - Firmware management utility for Mono Gateway Development Kit
#

set -euo pipefail

FIRMWARE_URL="https://firmware.mono.si"
PUBKEY="/etc/firmware/firmware-signing.pub"
DOWNLOAD_DIR="/tmp/firmware-update"
ENV_SIZE=8192  # 0x2000 bytes
ENV_OFFSET=3145728  # 0x300000

# MTD partitions (QSPI)
MTD_FLASH="/dev/mtd0"    # Entire NOR flash
MTD_ENV="/dev/mtd2"      # U-Boot environment

# eMMC device
EMMC_DEV="/dev/mmcblk0"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

info() {
    echo ":: $*"
}

# Detect boot medium from kernel command line (set by U-Boot)
detect_boot_medium() {
    local cmdline
    cmdline=$(cat /proc/cmdline)
    if [[ "$cmdline" =~ boot_medium=([a-z]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        die "Cannot detect boot medium. U-Boot must pass boot_medium= on kernel command line."
    fi
}

# Return the opposite medium
target_medium() {
    case "$1" in
        qspi) echo "emmc" ;;
        emmc) echo "qspi" ;;
        *) die "Unknown boot medium: $1" ;;
    esac
}

# Auto-detect MAC address from the first ethernet interface with one assigned
detect_mac() {
    local mac
    mac=$(ip -o link show | grep -m1 'ether' | sed 's|.*ether \([^ ]*\).*|\1|')
    if [ -z "$mac" ]; then
        die "Could not auto-detect MAC address. Ensure a network interface is available."
    fi
    echo "$mac"
}

# Check that networking is functional
check_network() {
    if ! ip route show default &>/dev/null || [ -z "$(ip route show default)" ]; then
        die "No default route configured. Set up networking first:
  ip link set <iface> up
  ip addr add <ip>/<mask> dev <iface>
  ip route add default via <gateway> dev <iface>"
    fi
}

# Clean up on exit
cleanup() {
    rm -rf "$DOWNLOAD_DIR"
}

cmd_update() {
    local boot_medium target

    boot_medium=$(detect_boot_medium)
    target=$(target_medium "$boot_medium")

    echo ""
    echo "╔═════════════════════════════════════════════════════════╗"
    echo "║                    FIRMWARE UPDATE                      ║"
    echo "╠═════════════════════════════════════════════════════════╣"
    echo "║  Booted from: ${boot_medium}                                      ║"
    echo "║  Target:      ${target}                                      ║"
    echo "║                                                         ║"
    echo "║  DO NOT power off or interrupt the device during the    ║"
    echo "║  update. Doing so may result in an unrecoverable state  ║"
    echo "║  requiring a hardware programmer to fix.                ║"
    echo "║                                                         ║"
    echo "║  For full documentation, visit: https://docs.mono.si/   ║"
    echo "╚═════════════════════════════════════════════════════════╝"
    echo ""
    read -rp "Type 'yes' to proceed: " confirm
    if [ "$confirm" != "yes" ]; then
        echo "Aborted."
        exit 0
    fi

    check_network

    local mac
    mac=$(detect_mac)
    info "Using MAC address: $mac"

    # Download firmware and signature
    trap cleanup EXIT
    mkdir -p "$DOWNLOAD_DIR"
    local fw_file="firmware-${target}-@MACHINE@.bin"
    local sig_file="firmware-${target}-@MACHINE@.bin.sig"

    info "Downloading firmware image..."
    curl -fS -u "mono:${mac}" -o "${DOWNLOAD_DIR}/${fw_file}" "${FIRMWARE_URL}/${fw_file}" || \
        die "Failed to download firmware image"

    info "Downloading signature..."
    curl -fS -u "mono:${mac}" -o "${DOWNLOAD_DIR}/${sig_file}" "${FIRMWARE_URL}/${sig_file}" || \
        die "Failed to download signature"

    # Verify signature
    if [ -f "$PUBKEY" ]; then
        info "Verifying firmware signature..."
        if ! openssl dgst -sha256 -verify "$PUBKEY" \
                -signature "${DOWNLOAD_DIR}/${sig_file}" \
                "${DOWNLOAD_DIR}/${fw_file}" >/dev/null 2>&1; then
            die "Signature verification FAILED. The firmware image may be corrupted or tampered with."
        fi
        info "Signature verified OK"
    else
        die "Public key not found at $PUBKEY. Cannot verify firmware integrity."
    fi

    # Back up U-Boot environment from the target medium
    info "Backing up U-Boot environment from ${target}..."
    if [ "$target" = "qspi" ]; then
        dd if="$MTD_ENV" of="${DOWNLOAD_DIR}/uboot-env.bin" bs=$ENV_SIZE count=1 2>/dev/null || \
            die "Failed to back up U-Boot environment from $MTD_ENV"
    else
        dd if="$EMMC_DEV" of="${DOWNLOAD_DIR}/uboot-env.bin" bs=1 skip=$ENV_OFFSET count=$ENV_SIZE 2>/dev/null || \
            die "Failed to back up U-Boot environment from $EMMC_DEV"
    fi
    info "Environment backed up"

    # Flash firmware
    info "Flashing firmware to ${target} (do not interrupt)..."
    if [ "$target" = "qspi" ]; then
        flashcp -v "${DOWNLOAD_DIR}/${fw_file}" "$MTD_FLASH" || \
            die "Flash failed!"
    else
        dd if="${DOWNLOAD_DIR}/${fw_file}" of="$EMMC_DEV" bs=4096 skip=1 seek=1 || \
            die "Flash failed!"
        sync
    fi
    info "Firmware flashed"

    # Restore U-Boot environment
    info "Restoring U-Boot environment..."
    if [ "$target" = "qspi" ]; then
        flashcp "${DOWNLOAD_DIR}/uboot-env.bin" "$MTD_ENV" || \
            die "Failed to restore U-Boot environment"
    else
        dd if="${DOWNLOAD_DIR}/uboot-env.bin" of="$EMMC_DEV" bs=1 seek=$ENV_OFFSET || \
            die "Failed to restore U-Boot environment"
        sync
    fi
    info "Environment restored"

    echo ""
    info "Firmware update complete. Reboot to use the new firmware."
}

cmd_backup() {
    local boot_medium target

    boot_medium=$(detect_boot_medium)
    target=$(target_medium "$boot_medium")

    local backup_file="/tmp/firmware-${target}-backup.bin"

    info "Booted from ${boot_medium}, backing up ${target} firmware..."
    if [ "$target" = "qspi" ]; then
        dd if="$MTD_FLASH" of="$backup_file" 2>/dev/null || \
            die "Failed to read from $MTD_FLASH"
    else
        dd if="$EMMC_DEV" of="$backup_file" bs=1M count=32 2>/dev/null || \
            die "Failed to read from $EMMC_DEV"
    fi

    local size
    size=$(stat -c%s "$backup_file")
    info "Backup saved to $backup_file ($((size / 1024 / 1024)) MB)"
}

cmd_version() {
    local version="unknown"
    if [ -f /etc/firmware/version ]; then
        version=$(cat /etc/firmware/version)
    fi
    echo "Mono Gateway Firmware v${version}"
}

cmd_help() {
    echo "Usage: firmware <command>"
    echo ""
    echo "Commands:"
    echo "  update    Download, verify, and flash firmware to the inactive medium"
    echo "  backup    Back up the inactive medium's firmware to /tmp"
    echo "  version   Show firmware version"
    echo "  help      Show this help message"
    echo ""
    echo "The tool auto-detects which medium the device booted from and"
    echo "always targets the other one (qspi <-> emmc)."
    echo ""
    echo "Examples:"
    echo "  firmware update     Update the inactive medium"
    echo "  firmware backup     Back up the inactive medium"
    echo ""
    echo "Documentation: https://docs.mono.si/"
}

# Main dispatch
case "${1:-help}" in
    update)  shift; cmd_update "$@" ;;
    backup)  shift; cmd_backup "$@" ;;
    version) cmd_version ;;
    help|--help|-h) cmd_help ;;
    *) die "Unknown command: $1. Run 'firmware help' for usage." ;;
esac
